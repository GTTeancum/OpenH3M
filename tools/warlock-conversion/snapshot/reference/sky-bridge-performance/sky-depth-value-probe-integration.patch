+void D3D12RenderTargetCache::ProbeSkyDepth(uint64_t frame,uint64_t sequence,uint64_t shader,
+    uint32_t count,uint32_t phase,bool guest_query,bool memexport,uint64_t submission,uint64_t completed) {
+  auto& probe=SkyDepthValueProbe::Get();if(!probe.Enabled())return;
+  const bool host=GetPath()==Path::kHostRenderTargets;
+  auto* depth=host&&(GetLastUpdateBoundRenderTargets()&1)
+      ?static_cast<D3D12RenderTarget*>(last_update_accumulated_render_targets()[0]):nullptr;
+  auto& cp=command_processor_;
+  probe.Record(cp.GetD3D12Provider().GetDevice(),cp.GetDeferredCommandList(),depth?depth->resource():nullptr,
+    depth?GetDepthSRVDepthDXGIFormat(depth->key().GetDepthFormat()):DXGI_FORMAT_UNKNOWN,
+    depth?depth->resource_state():D3D12_RESOURCE_STATE_COMMON,
+    frame,sequence,shader,count,phase,guest_query,memexport,host,submission,completed,
+    [&](D3D12_CPU_DESCRIPTOR_HANDLE& cpu,D3D12_GPU_DESCRIPTOR_HANDLE& gpu){
+      ui::d3d12::util::DescriptorCpuGpuHandlePair handles;
+      if(!cp.RequestOneUseSingleViewDescriptors(1,&handles))return false;
+      cpu=handles.first;gpu=handles.second;return true;
+    },
+    [&](ID3D12PipelineState* pipeline){cp.SetExternalPipeline(pipeline);},
+    [&](ID3D12Resource* resource,D3D12_RESOURCE_STATES before,D3D12_RESOURCE_STATES after){cp.PushTransitionBarrier(resource,before,after);},
+    [&](){cp.SubmitBarriers();});
