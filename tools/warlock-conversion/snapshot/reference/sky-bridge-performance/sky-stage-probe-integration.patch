+void D3D12RenderTargetCache::ProbeSkyDraw(uint64_t frame,uint64_t sequence,uint64_t shader,
+    uint32_t count,uint32_t phase,uint64_t submission,uint64_t completed) {
+  auto& probe=SkyStageProbe::Get();
+  if(!probe.Enabled()||(count!=28632&&count!=21858)||
+     (shader!=8562590739555380577ull&&shader!=14617156369365479079ull&&shader!=14007674117786981017ull))return;
+  if(GetPath()!=Path::kHostRenderTargets||!(GetLastUpdateBoundRenderTargets()&2))return;
+  auto* target=static_cast<D3D12RenderTarget*>(last_update_accumulated_render_targets()[1]);
+  if(!target)return;
+  auto* resource=target->resource();
+  probe.Record(command_processor_.GetD3D12Provider().GetDevice(),resource,
+    GetColorDrawDXGIFormat(target->key().GetColorFormat()),frame,sequence,shader,count,phase,
+    submission,completed,[&](ID3D12Resource* destination){
+      const auto old=target->SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE);
+      command_processor_.PushTransitionBarrier(resource,old,D3D12_RESOURCE_STATE_COPY_SOURCE);
+      command_processor_.SubmitBarriers();
+      D3D12_TEXTURE_COPY_LOCATION source{};source.pResource=resource;
+      source.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+      D3D12_TEXTURE_COPY_LOCATION output{};output.pResource=destination;
+      output.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+      output.PlacedFootprint.Footprint={resource->GetDesc().Format,1,1,1,256};
+      for(uint32_t i=0;i<probe.points.size();++i){
+        const auto& p=probe.points[i];D3D12_BOX box{p[0],p[1],0,p[0]+1,p[1]+1,1};
+        output.PlacedFootprint.Offset=i*512;
+        command_processor_.GetDeferredCommandList().D3DCopyTextureRegion(&output,0,0,0,&source,&box);
+      }
+      command_processor_.PushTransitionBarrier(resource,D3D12_RESOURCE_STATE_COPY_SOURCE,old);
+      target->SetResourceState(old);command_processor_.SubmitBarriers();
+    });
 }
 
