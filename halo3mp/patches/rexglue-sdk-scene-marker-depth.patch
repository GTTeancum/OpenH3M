+ID3D12Resource* D3D12RenderTargetCache::GetSceneDepthResource() const {
+  if (GetPath() != Path::kHostRenderTargets || !(GetLastUpdateBoundRenderTargets() & 1)) return nullptr;
+  auto* depth = static_cast<D3D12RenderTarget*>(last_update_accumulated_render_targets()[0]);
+  return depth ? depth->resource() : nullptr;
+}
+
+void D3D12RenderTargetCache::CopySceneDepth(ID3D12Resource* destination) {
+  auto* depth = static_cast<D3D12RenderTarget*>(last_update_accumulated_render_targets()[0]);
+  auto old_state = depth->SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.PushTransitionBarrier(depth->resource(), old_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.SubmitBarriers();
+  command_processor_.GetDeferredCommandList().D3DCopyResource(destination, depth->resource());
+  command_processor_.PushTransitionBarrier(depth->resource(), D3D12_RESOURCE_STATE_COPY_SOURCE, old_state);
+  depth->SetResourceState(old_state);
 }
 
