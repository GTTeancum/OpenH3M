+// Opt-in test input; never sends OS input and never merges live controller drift.
+struct ReplayFrame {
+  uint32_t ms;
+  uint16_t buttons;
+  int16_t lx, ly, rx, ry;
+  uint8_t lt, rt;
+};
+
+u32 ReplayUserZero(ppc_ptr_t<X_INPUT_STATE> state) {
+  const uint32_t ms = ScriptElapsedMs();
+  static const auto frames = [] {
+    std::ifstream file(REXCVAR_GET(input_state_replay), std::ios::binary);
+    std::array<uint8_t, 8> header{};
+    if (!file.read(reinterpret_cast<char*>(header.data()), header.size()) ||
+        std::memcmp(header.data(), "H3IR", 4) != 0) REX_FATAL("Invalid input replay header");
+    auto u16 = [](const uint8_t* p) { return uint16_t(p[0] | (uint16_t(p[1]) << 8)); };
+    auto u32 = [](const uint8_t* p) {
+      return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+    };
+    const uint32_t count = u32(header.data() + 4);
+    if (!count || count > 100000) REX_FATAL("Invalid input replay count");
+    std::vector<ReplayFrame> result;
+    result.reserve(count);
+    for (uint32_t i = 0; i < count; ++i) {
+      std::array<uint8_t, 16> b{};
+      if (!file.read(reinterpret_cast<char*>(b.data()), b.size())) REX_FATAL("Truncated input replay");
+      ReplayFrame f{u32(b.data()), u16(b.data() + 4),
+          static_cast<int16_t>(u16(b.data() + 6)), static_cast<int16_t>(u16(b.data() + 8)),
+          static_cast<int16_t>(u16(b.data() + 10)), static_cast<int16_t>(u16(b.data() + 12)), b[14], b[15]};
+      if (f.ms > 3600000 || (!result.empty() && f.ms < result.back().ms))
+        REX_FATAL("Invalid input replay timestamps");
+      result.push_back(f);
+    }
+    if (file.peek() != std::ifstream::traits_type::eof()) REX_FATAL("Trailing input replay bytes");
+    REXKRNL_INFO("[input-replay] loaded {} frames, last_ms={}; live user-0 input excluded",
+                result.size(), result.back().ms);
+    return result;
+  }();
+  if (!state) return X_ERROR_SUCCESS;
+  const auto next = std::upper_bound(frames.begin(), frames.end(), ms,
+      [](uint32_t time, const ReplayFrame& f) { return time < f.ms; });
+  const uint32_t packet = static_cast<uint32_t>(next - frames.begin()) + 1;
+  const ReplayFrame f = next == frames.begin() ? ReplayFrame{} : *(next - 1);
+  std::memset(state, 0, sizeof(X_INPUT_STATE));
+  state->packet_number = packet;
+  state->gamepad.buttons = f.buttons;
+  state->gamepad.thumb_lx = f.lx; state->gamepad.thumb_ly = f.ly;
+  state->gamepad.thumb_rx = f.rx; state->gamepad.thumb_ry = f.ry;
+  state->gamepad.left_trigger = f.lt; state->gamepad.right_trigger = f.rt;
+  static thread_local uint32_t last_packet = 0;
+  if (packet != last_packet) {
+    REXKRNL_INFO("[input-replay] t={}ms frame={} buttons={} lx={} ly={} rx={} ry={} lt={} rt={}",
+        ms, packet - 1, f.buttons, f.lx, f.ly, f.rx, f.ry, f.lt, f.rt);
+    last_packet = packet;
+  }
+  return X_ERROR_SUCCESS;
+}
