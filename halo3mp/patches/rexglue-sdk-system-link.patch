+        auto guest_socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(handle);
+        if (guest_socket && IsSystemLinkGuestSocket(*guest_socket) &&
+            guest_socket->bound_port() == datagram.destination_port &&
+            guest_socket->QueuePacket(1, datagram.source_port, datagram.data.data(),
+                                      datagram.data.size())) {
+          ++delivered;
+        }
+      }
+    }
+    if (REXCVAR_GET(xnet_metadata_log) && (count <= 16 || count % 256 == 0)) {
+      if (authenticated) {
+        REXKRNL_INFO(
+            "[xnet] Raw System Link broadcast-version frame bytes={} "
+            "udp_payload_bytes={} title_datagram_bytes={} source_port={} "
+            "destination_port={} title_id={:#010x} title_version={} "
+            "system_version={:#010x} matching_title={} compatible_version={} "
+            "authenticated=true key_variant={} delivered={} packets={} payload_log=false",
+            packet.frame_size, packet.payload.size(), datagram.data.size(), datagram.source_port,
+            datagram.destination_port, datagram.title_id, datagram.title_version,
+            datagram.system_version, matching_title, compatible_title_version, key_variant,
+            delivered, count);
+      } else if (packet.payload_kind == SystemLinkRawPayloadKind::kBroadcastVersion) {
+        const bool matching_title = packet.title_id == REX_KERNEL_STATE()->title_id();
+        REXKRNL_INFO(
+            "[xnet] Raw System Link broadcast-version frame bytes={} "
+            "udp_payload_bytes={} title_id={:#010x} title_version={} "
+            "system_version={:#010x} ip_identification={:#06x} "
+            "broadcast_sequence={:#06x} "
+            "matching_title={} authenticated=false "
+            "decode_stage={} key_variants_tested={} packets={} payload_log=false",
+            packet.frame_size, packet.payload.size(), packet.title_id, packet.broadcast_version,
+            packet.system_version, packet.ipv4_identification, packet.broadcast_sequence,
+            matching_title,
+            decode_diagnostics.status == SystemLinkBroadcastDecodeStatus::kAuthenticationFailed
+                ? "authentication"
+            : decode_diagnostics.status == SystemLinkBroadcastDecodeStatus::kInvalidPadding
+                ? "padding"
+                : "layout",
+            state.diagnostic_broadcast_keys.size(), count);
+      } else {
+        REXKRNL_INFO(
+            "[xnet] Raw System Link console frame bytes={} udp_payload_bytes={} "
+            "kind=unknown authenticated=false packets={} payload_log=false",
+            packet.frame_size, packet.payload.size(), count);
+      }
+    }
+    if (REXCVAR_GET(xnet_system_link_raw_reflect_beacon) && authenticated &&
+        compatible_title_version &&
+        packet.payload_kind == SystemLinkRawPayloadKind::kBroadcastVersion &&
+        std::find(state.reflected_beacons.begin(), state.reflected_beacons.end(),
+                  packet.source_mac) == state.reflected_beacons.end()) {
+      std::string send_error;
+      if (state.transport.SendPayloadTo(packet.source_mac, packet.payload, &send_error)) {
+        state.reflected_beacons.push_back(packet.source_mac);
+        if (REXCVAR_GET(xnet_metadata_log)) {
+          REXKRNL_INFO(
+              "[xnet] Raw System Link reflected one matching authenticated "
+              "beacon destination=source-console bytes={} payload_log=false",
+              packet.payload.size());
+        }
+      } else if (REXCVAR_GET(xnet_metadata_log)) {
+        REXKRNL_WARN("[xnet] Raw System Link beacon reflection failed: {}", send_error);
+      }
+    }
+  }
+}
