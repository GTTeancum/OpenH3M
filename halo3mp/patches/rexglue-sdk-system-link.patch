+
+SystemLinkBroadcastKeys DeriveSystemLinkBroadcastKeys(const std::array<uint8_t, 16>& title_lan_key);
+bool DecodeSystemLinkBroadcast(std::span<const uint8_t> payload,
+                               const SystemLinkBroadcastKeys& keys,
+                               SystemLinkBroadcastDatagram* datagram,
+                               SystemLinkBroadcastDecodeDiagnostics* diagnostics = nullptr);
+bool DiagnoseSystemLinkBroadcastAuthentication(std::span<const uint8_t> payload,
+                                               const SystemLinkBroadcastKeys& keys,
+                                               SystemLinkBroadcastDecodeDiagnostics* diagnostics);
+bool EncodeSystemLinkBroadcast(std::span<const uint8_t> data, uint16_t source_port,
+                               uint16_t destination_port, uint32_t title_id, uint32_t title_version,
+                               uint32_t system_version, uint16_t sequence,
+                               const SystemLinkBroadcastKeys& keys, std::vector<uint8_t>* payload);
+
+bool ParseSystemLinkRawFrame(std::span<const uint8_t> frame, SystemLinkRawPacket* packet);
+bool BuildSystemLinkRawFrame(const std::array<uint8_t, 6>& source_mac,
+                             const std::array<uint8_t, 6>& destination_mac,
+                             std::span<const uint8_t> payload, std::vector<uint8_t>* frame);
+
+class SystemLinkRawTransport {
+ public:
+  SystemLinkRawTransport();
+  ~SystemLinkRawTransport();
+
+  SystemLinkRawTransport(const SystemLinkRawTransport&) = delete;
+  SystemLinkRawTransport& operator=(const SystemLinkRawTransport&) = delete;
+
+  bool Open(uint32_t local_ipv4, const std::array<uint8_t, 6>& local_mac, std::string* error);
+  void Close();
+  bool is_open() const;
+
+  size_t Poll(std::vector<SystemLinkRawPacket>* packets, size_t max_packets, std::string* error);
+  bool SendFrame(std::span<const uint8_t> frame, std::string* error);
+  bool SendPayloadTo(const std::array<uint8_t, 6>& destination_mac,
+                     std::span<const uint8_t> payload, std::string* error);
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace rex::kernel::xam
