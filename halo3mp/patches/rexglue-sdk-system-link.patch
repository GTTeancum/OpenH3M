+bool IsLocalMacAddress(const uint8_t* mac) {
+  const HostNetworkIdentity& identity = GetHostNetworkIdentity();
+  return identity.available &&
+         std::equal(identity.mac.begin(), identity.mac.end(), mac);
+}
+
+bool GetTitleLanKey(std::array<uint8_t, 16>* key) {
+  auto module = REX_KERNEL_STATE()->GetExecutableModule();
+  if (!module) {
+    return false;
+  }
+  xex2_opt_lan_key* lan_key = nullptr;
+  if (XFAILED(module->GetOptHeader(XEX_HEADER_LAN_KEY, &lan_key)) || !lan_key) {
+    return false;
+  }
+  std::copy(std::begin(lan_key->key), std::end(lan_key->key), key->begin());
+  return true;
+}
+
+bool GetTitleSystemFlags(uint32_t* flags) {
+  auto module = REX_KERNEL_STATE()->GetExecutableModule();
+  if (!module) {
+    return false;
+  }
+  return XSUCCEEDED(module->GetOptHeader<uint32_t>(XEX_HEADER_SYSTEM_FLAGS, flags));
+}
