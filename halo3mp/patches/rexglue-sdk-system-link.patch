+bool SendRawSystemLinkBroadcast(uint8_t* data, uint32_t data_length, uint16_t source_port,
+                                uint16_t destination_port) {
+  auto& state = GetSystemLinkRawTransportState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (!EnsureSystemLinkRawTransportLocked(state)) {
+    return false;
+  }
+
+  uint32_t title_version = 0;
+  GetTitleVersion(&title_version);
+  const uint16_t sequence = state.next_sequence++;
+  std::vector<uint8_t> payload;
+  if (!EncodeSystemLinkBroadcast(std::span<const uint8_t>(data, data_length), source_port,
+                                 destination_port, REX_KERNEL_STATE()->title_id(), title_version,
+                                 state.peer_system_version, sequence, state.broadcast_keys,
+                                 &payload)) {
+    return false;
+  }
+
+  constexpr std::array<uint8_t, 6> broadcast_mac = {
+      0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
+  };
+  std::string error;
+  const bool sent = state.transport.SendPayloadTo(broadcast_mac, payload, &error);
+  if (REXCVAR_GET(xnet_metadata_log)) {
+    if (sent) {
+      const uint64_t count =
+          xnet_raw_console_sent_packets.fetch_add(1, std::memory_order_relaxed) + 1;
+      REXKRNL_INFO(
+          "[xnet] Raw System Link title broadcast title_datagram_bytes={} "
+          "udp_payload_bytes={} source_port={} destination_port={} "
+          "authenticated=true packets={} payload_log=false",
+          data_length, payload.size(), source_port, destination_port, count);
+    } else {
+      REXKRNL_WARN("[xnet] Raw System Link title broadcast failed: {}", error);
+    }
+  }
+  return sent;
+}
+
+struct SystemLinkTransportSocket {
+  std::mutex mutex;
+  SOCKET socket = INVALID_SOCKET;
+  uint16_t bound_port = 0;
+  bool attempted = false;
+};
+
+SystemLinkTransportSocket& GetSystemLinkTransportSocket() {
+  static SystemLinkTransportSocket transport;
+  return transport;
+}
+
+void CloseSystemLinkTransportSocket() {
+  CloseSystemLinkRawTransport();
+  auto& transport = GetSystemLinkTransportSocket();
+  std::lock_guard<std::mutex> lock(transport.mutex);
+  if (transport.socket != INVALID_SOCKET) {
+    closesocket(transport.socket);
+    transport.socket = INVALID_SOCKET;
+  }
+  transport.bound_port = 0;
+  transport.attempted = false;
+}
+
+void EnsureSystemLinkTransportSocket() {
+  uint16_t port;
+  {
+    auto& registry = GetXNetAddressRegistry();
+    std::lock_guard<std::mutex> lock(registry.mutex);
+    port = registry.system_link_port;
+  }
+
+  auto& transport = GetSystemLinkTransportSocket();
+  std::lock_guard<std::mutex> lock(transport.mutex);
+  if (transport.socket != INVALID_SOCKET && transport.bound_port == port) {
+    return;
+  }
+  if (transport.attempted && transport.bound_port == port) {
+    return;
+  }
+  if (transport.socket != INVALID_SOCKET) {
+    closesocket(transport.socket);
+    transport.socket = INVALID_SOCKET;
+  }
+  transport.attempted = true;
+  transport.bound_port = port;
+
+  transport.socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (transport.socket == INVALID_SOCKET) {
+    REXKRNL_WARN("[xnet] System Link transport socket creation failed error={}", WSAGetLastError());
+    return;
+  }
+  BOOL enabled = TRUE;
+  setsockopt(transport.socket, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&enabled),
+             sizeof(enabled));
+  setsockopt(transport.socket, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&enabled),
+             sizeof(enabled));
+  u_long nonblocking = 1;
+  ioctlsocket(transport.socket, FIONBIO, &nonblocking);
+
+  sockaddr_in address{};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_ANY);
+  address.sin_port = htons(port);
+  if (::bind(transport.socket, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) != 0) {
+    const int error = WSAGetLastError();
+    closesocket(transport.socket);
+    transport.socket = INVALID_SOCKET;
+    REXKRNL_WARN("[xnet] System Link transport bind port={} failed error={}", port, error);
+    return;
+  }
+  if (REXCVAR_GET(xnet_metadata_log)) {
+    REXKRNL_INFO("[xnet] System Link console transport listening UDP port={} payload_log=false",
+                 port);
+  }
+}
+
+void PollSystemLinkTransportSocket() {
+  PollSystemLinkRawTransport();
+  EnsureSystemLinkTransportSocket();
+  auto& transport = GetSystemLinkTransportSocket();
+  std::lock_guard<std::mutex> lock(transport.mutex);
+  if (transport.socket == INVALID_SOCKET) {
+    return;
+  }
+
+  for (uint32_t i = 0; i < 8; ++i) {
+    std::array<uint8_t, 2048> packet;
+    sockaddr_in from{};
+    int from_length = sizeof(from);
+    const int result = recvfrom(transport.socket, reinterpret_cast<char*>(packet.data()),
+                                static_cast<int>(packet.size()), 0,
+                                reinterpret_cast<sockaddr*>(&from), &from_length);
+    if (result < 0) {
+      const int error = WSAGetLastError();
+      if (error != WSAEWOULDBLOCK && REXCVAR_GET(xnet_metadata_log)) {
+        REXKRNL_WARN("[xnet] System Link console transport receive failed error={}", error);
+      }
+      break;
+    }
+    if (REXCVAR_GET(xnet_system_link_raw_transport) && from.sin_addr.s_addr == htonl(1)) {
+      continue;
+    }
+    uint32_t delivered = 0;
+    const auto guest_handles = GetSystemLinkGuestSocketHandles();
+    for (uint32_t handle : guest_handles) {
+      auto guest_socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(handle);
+      if (guest_socket && IsSystemLinkGuestSocket(*guest_socket) &&
+          guest_socket->QueuePacket(ntohl(from.sin_addr.s_addr), ntohs(from.sin_port),
+                                    packet.data(), static_cast<size_t>(result))) {
+        ++delivered;
+      }
+    }
+
+    const uint64_t packets = xnet_console_packets.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (REXCVAR_GET(xnet_metadata_log) && (packets <= 16 || packets % 256 == 0)) {
+      REXKRNL_INFO(
+          "[xnet] System Link console datagram bytes={} address={:#010x} port={} "
+          "delivered={} packets={} payload_log=false",
+          result, static_cast<uint32_t>(from.sin_addr.s_addr), ntohs(from.sin_port), delivered,
+          packets);
+    }
+  }
+}
+
+int SendSystemLinkTransportPacket(XSocket& guest_socket, uint8_t* data, uint32_t data_length,
+                                  uint32_t flags, const N_XSOCKADDR_IN* to) {
+  EnsureSystemLinkTransportSocket();
+  auto& transport = GetSystemLinkTransportSocket();
+  std::lock_guard<std::mutex> lock(transport.mutex);
+  if (transport.socket == INVALID_SOCKET || !to) {
+    WSASetLastError(WSAENETDOWN);
+    return -1;
+  }
+
+  sockaddr_in destination{};
+  destination.sin_family = AF_INET;
+  destination.sin_addr.s_addr = htonl(static_cast<uint32_t>(to->sin_addr));
+  destination.sin_port = htons(transport.bound_port);
+  const int result =
+      sendto(transport.socket, reinterpret_cast<const char*>(data), data_length, flags,
+             reinterpret_cast<const sockaddr*>(&destination), sizeof(destination));
+  if (destination.sin_addr.s_addr == htonl(INADDR_BROADCAST) &&
+      REXCVAR_GET(xnet_system_link_raw_transport)) {
+    SendRawSystemLinkBroadcast(data, data_length, guest_socket.bound_port(),
+                               static_cast<uint16_t>(to->sin_port));
+  }
+  const std::string probe_address = REXCVAR_GET(xnet_system_link_probe_address);
+  if (result >= 0 && destination.sin_addr.s_addr == htonl(INADDR_BROADCAST) &&
+      !probe_address.empty()) {
+    sockaddr_in probe_destination = destination;
+    if (inet_pton(AF_INET, probe_address.c_str(), &probe_destination.sin_addr) == 1) {
+      const int probe_result =
+          sendto(transport.socket, reinterpret_cast<const char*>(data), data_length, flags,
+                 reinterpret_cast<const sockaddr*>(&probe_destination), sizeof(probe_destination));
+      if (REXCVAR_GET(xnet_metadata_log)) {
+        if (probe_result >= 0) {
+          REXKRNL_INFO(
+              "[xnet] System Link targeted probe address={} port={} bytes={} "
+              "payload_log=false",
+              probe_address, transport.bound_port, probe_result);
+        } else {
+          REXKRNL_WARN("[xnet] System Link targeted probe address={} port={} failed error={}",
+                       probe_address, transport.bound_port, WSAGetLastError());
+        }
+      }
+    } else if (REXCVAR_GET(xnet_metadata_log)) {
+      REXKRNL_WARN("[xnet] System Link targeted probe has invalid IPv4 address={}", probe_address);
+    }
+  }
+  if (result >= 0) {
+    const uint64_t packets = xnet_console_sent_packets.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (REXCVAR_GET(xnet_metadata_log) && (packets <= 16 || packets % 256 == 0)) {
+      REXKRNL_INFO(
+          "[xnet] System Link title datagram socket_port={} logical_port={} "
+          "external_port={} bytes={} address={:#010x} packets={} payload_log=false",
+          guest_socket.bound_port(), static_cast<uint16_t>(to->sin_port), transport.bound_port,
+          result, static_cast<uint32_t>(to->sin_addr), packets);
+    }
+  }
+  return result;
+}
+#else
+void CloseSystemLinkRawTransport() {}
+void PollSystemLinkRawTransport() {}
+void CloseSystemLinkTransportSocket() {}
+void EnsureSystemLinkTransportSocket() {}
+void PollSystemLinkTransportSocket() {}
+int SendSystemLinkTransportPacket(XSocket& guest_socket, uint8_t* data, uint32_t data_length,
+                                  uint32_t flags, const N_XSOCKADDR_IN* to) {
+  return guest_socket.SendTo(data, data_length, flags, const_cast<N_XSOCKADDR_IN*>(to),
+                             sizeof(N_XSOCKADDR_IN));
+}
+#endif
