+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+  const uint32_t profile_signin_state = user_profile->signin_state();
+  const uint64_t profile_xuid = user_profile->xuid();
+  snapshot.signin_state.fill(0);
+  snapshot.type.fill(0);
+  snapshot.xuid.fill(0);
+  for (uint32_t user = 0; user < 4; ++user) {
+    if (!(active_mask & (1u << user))) {
