+
+void PollSystemLinkRawTransport() {
+  auto& state = GetSystemLinkRawTransportState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (!REXCVAR_GET(xnet_system_link_raw_transport)) {
+    if (state.transport.is_open()) {
+      state.transport.Close();
+    }
+    state.attempted = false;
+    state.reflected_beacons.clear();
+    return;
+  }
+
+  if (!state.transport.is_open()) {
+    if (state.attempted) {
+      return;
+    }
+    state.attempted = true;
+    const auto& identity = GetHostNetworkIdentity();
+    if (!identity.available) {
+      REXKRNL_WARN("[xnet] Raw System Link transport has no eligible network adapter");
+      return;
+    }
+    std::string error;
+    if (!state.transport.Open(identity.ipv4, identity.mac, &error)) {
+      REXKRNL_WARN("[xnet] Raw System Link transport unavailable: {}", error);
+      return;
+    }
+    REXKRNL_INFO(
+        "[xnet] Raw System Link transport active filter=xbox-udp-3074 "
+        "promiscuous=false payload_log=false");
+  }
+
+  std::vector<SystemLinkRawPacket> packets;
+  std::string error;
+  state.transport.Poll(&packets, 8, &error);
+  if (!error.empty()) {
+    REXKRNL_WARN("[xnet] Raw System Link receive failed: {}", error);
+    state.transport.Close();
+    return;
+  }
+  for (const auto& packet : packets) {
+    const uint64_t count =
+        xnet_raw_console_packets.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (REXCVAR_GET(xnet_metadata_log) && (count <= 16 || count % 256 == 0)) {
+      if (packet.payload_kind == SystemLinkRawPayloadKind::kBroadcastVersion) {
+        const bool matching_title = packet.title_id == REX_KERNEL_STATE()->title_id();
+        REXKRNL_INFO(
+            "[xnet] Raw System Link broadcast-version frame bytes={} "
+            "udp_payload_bytes={} title_id={:#010x} broadcast_version={} "
+            "matching_title={} authenticated=false packets={} payload_log=false",
+            packet.frame_size, packet.payload.size(), packet.title_id,
+            packet.broadcast_version, matching_title, count);
+      } else {
+        REXKRNL_INFO(
+            "[xnet] Raw System Link console frame bytes={} udp_payload_bytes={} "
+            "kind=unknown authenticated=false packets={} payload_log=false",
+            packet.frame_size, packet.payload.size(), count);
+      }
+    }
+    if (REXCVAR_GET(xnet_system_link_raw_reflect_beacon) &&
+        packet.payload_kind == SystemLinkRawPayloadKind::kBroadcastVersion &&
+        packet.title_id == REX_KERNEL_STATE()->title_id() &&
+        std::find(state.reflected_beacons.begin(), state.reflected_beacons.end(),
+                  packet.source_mac) == state.reflected_beacons.end()) {
+      std::string send_error;
+      if (state.transport.SendPayloadTo(packet.source_mac, packet.payload,
+                                        &send_error)) {
+        state.reflected_beacons.push_back(packet.source_mac);
+        if (REXCVAR_GET(xnet_metadata_log)) {
+          REXKRNL_INFO(
+              "[xnet] Raw System Link reflected one matching authenticated "
+              "beacon destination=source-console bytes={} payload_log=false",
+              packet.payload.size());
+        }
+      } else if (REXCVAR_GET(xnet_metadata_log)) {
+        REXKRNL_WARN("[xnet] Raw System Link beacon reflection failed: {}",
+                     send_error);
+      }
+    }
+  }
+}
