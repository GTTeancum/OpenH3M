+D3D12PerfStats g_d3d12_perf;
+
+uint64_t PerfNowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+struct PerfTimer {
+  explicit PerfTimer(std::atomic<uint64_t>* target_ns)
+      : target_ns(target_ns), start(std::chrono::steady_clock::now()) {}
+
+  ~PerfTimer() {
+    if (!target_ns) {
+      return;
+    }
+    const auto elapsed_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now() - start)
+                                .count();
+    target_ns->fetch_add(uint64_t(elapsed_ns), std::memory_order_relaxed);
+  }
+
+  std::atomic<uint64_t>* target_ns;
+  std::chrono::steady_clock::time_point start;
+};
+
+std::atomic<uint64_t>* PerfTarget(std::atomic<uint64_t>& target) {
+  return REXCVAR_GET(d3d12_perf_summary_interval_ms) ? &target : nullptr;
+}
