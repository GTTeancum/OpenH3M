+  auto& counters = XamUserGetSigninStateCallerCounters();
+  for (auto& caller : counters) {
+    uint32_t lr = caller.lr.load(std::memory_order_relaxed);
+    if (lr == caller_lr) {
+      caller.count.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    if (!lr && caller.lr.compare_exchange_strong(lr, caller_lr, std::memory_order_relaxed)) {
+      caller.count.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+  }
+}
