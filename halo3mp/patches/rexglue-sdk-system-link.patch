+bool FillXNetKeyBytes(uint8_t* output, size_t length) {
+#if REX_PLATFORM_WIN32
+  return BCryptGenRandom(nullptr, output, static_cast<ULONG>(length),
+                         BCRYPT_USE_SYSTEM_PREFERRED_RNG) >= 0;
+#else
+  uint64_t state = static_cast<uint64_t>(std::chrono::high_resolution_clock::now()
+                                             .time_since_epoch()
+                                             .count()) ^
+                   (xnet_key_sequence.fetch_add(1, std::memory_order_relaxed) + 1);
+  for (size_t i = 0; i < length; ++i) {
+    state ^= state << 13;
+    state ^= state >> 7;
+    state ^= state << 17;
+    output[i] = static_cast<uint8_t>(state >> ((i & 7) * 8));
+  }
+  return true;
+#endif
+}
+
+u32 NetDll_XNetCreateKey_entry(u32 caller, ppc_ptr_t<XNKID> key_id,
+                               ppc_ptr_t<XNKEY> exchange_key) {
+  if (!key_id || !exchange_key) {
+    return 0x271E;  // WSAEFAULT
+  }
+  if (!FillXNetKeyBytes(key_id->ab, sizeof(key_id->ab)) ||
+      !FillXNetKeyBytes(exchange_key->ab, sizeof(exchange_key->ab))) {
+    return 0x2747;  // WSAENOBUFS
+  }
+  key_id->ab[0] &= 0x1F;  // System Link key type.
+  if (REXCVAR_GET(xnet_metadata_log)) {
+    REXKRNL_INFO("[xnet] XNetCreateKey caller={} key_id={:#x} exchange_key={:#x} result=0",
+                 caller, key_id.guest_address(), exchange_key.guest_address());
+  }
+  return 0;
+}
+
+u32 NetDll_XNetRegisterKey_entry(u32 caller, ppc_ptr_t<XNKID> key_id,
+                                 ppc_ptr_t<XNKEY> exchange_key) {
+  if (!key_id || !exchange_key) {
+    return 0x271E;  // WSAEFAULT
+  }
+  std::array<uint8_t, 8> id;
+  std::array<uint8_t, 16> key;
+  std::memcpy(id.data(), key_id->ab, id.size());
+  std::memcpy(key.data(), exchange_key->ab, key.size());
+  auto& registry = GetXNetKeyRegistry();
+  size_t registered;
+  {
+    std::lock_guard<std::mutex> lock(registry.mutex);
+    registry.keys[id] = key;
+    registered = registry.keys.size();
+  }
+  if (REXCVAR_GET(xnet_metadata_log)) {
+    REXKRNL_INFO("[xnet] XNetRegisterKey caller={} key_id={:#x} exchange_key={:#x} "
+                 "registered={} result=0",
+                 caller, key_id.guest_address(), exchange_key.guest_address(), registered);
+  }
+  return 0;
+}
+
+u32 NetDll_XNetUnregisterKey_entry(u32 caller, ppc_ptr_t<XNKID> key_id) {
+  if (!key_id) {
+    return 0x271E;  // WSAEFAULT
+  }
+  std::array<uint8_t, 8> id;
+  std::memcpy(id.data(), key_id->ab, id.size());
+  auto& registry = GetXNetKeyRegistry();
+  size_t remaining;
+  {
+    std::lock_guard<std::mutex> lock(registry.mutex);
+    registry.keys.erase(id);
+    remaining = registry.keys.size();
+  }
+  if (REXCVAR_GET(xnet_metadata_log)) {
+    REXKRNL_INFO("[xnet] XNetUnregisterKey caller={} key_id={:#x} registered={} result=0",
+                 caller, key_id.guest_address(), remaining);
+  }
+  return 0;
+}
