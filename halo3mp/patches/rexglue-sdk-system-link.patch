+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam {
+
+enum class SystemLinkRawPayloadKind {
+  kUnknown,
+  kBroadcastVersion,
+};
+
+struct SystemLinkRawPacket {
+  std::array<uint8_t, 6> source_mac{};
+  std::array<uint8_t, 6> destination_mac{};
+  uint32_t frame_size = 0;
+  SystemLinkRawPayloadKind payload_kind = SystemLinkRawPayloadKind::kUnknown;
+  uint32_t title_id = 0;
+  uint32_t broadcast_version = 0;
+  std::vector<uint8_t> payload;
