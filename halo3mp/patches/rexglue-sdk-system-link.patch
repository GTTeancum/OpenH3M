+  const uint32_t native_address = htonl(in_addr);
+  std::lock_guard<std::mutex> lock(registry.mutex);
+  const auto it = registry.addresses.find(native_address);
+  if (it == registry.addresses.end()) {
+    return 0x2726;  // WSAEINVAL
+  }
+  it->second.connected = true;
+  return 0;
