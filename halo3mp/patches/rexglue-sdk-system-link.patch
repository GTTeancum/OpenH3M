+enum class SystemLinkBroadcastDecodeStatus {
+  kInvalidLayout,
+  kAuthenticationFailed,
+  kInvalidPadding,
+  kSuccess,
+};
+
+struct SystemLinkBroadcastDecodeDiagnostics {
+  SystemLinkBroadcastDecodeStatus status = SystemLinkBroadcastDecodeStatus::kInvalidLayout;
+  bool alternative_authentication_matched = false;
+  uint8_t authentication_mutation = 0;
+  uint8_t authentication_first_offset = 0;
+  uint8_t authentication_first_size = 0;
+  uint8_t authentication_second_offset = 0;
