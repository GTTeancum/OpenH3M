+bool GetTitleLanKey(std::array<uint8_t, 16>* key) {
+  auto module = REX_KERNEL_STATE()->GetExecutableModule();
+  if (!module) {
+    return false;
+  }
+  xex2_opt_lan_key* lan_key = nullptr;
+  if (XFAILED(module->GetOptHeader(XEX_HEADER_LAN_KEY, &lan_key)) || !lan_key) {
+    return false;
+  }
+  std::copy(std::begin(lan_key->key), std::end(lan_key->key), key->begin());
+  return true;
+}
