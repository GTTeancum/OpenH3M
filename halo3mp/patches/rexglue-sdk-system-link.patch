+void RefreshLocalUserSnapshot() {
+  auto& snapshot = MutableLocalUserSnapshot();
+  if (snapshot.initialized &&
+      snapshot.next_activation_ms == std::numeric_limits<uint32_t>::max()) {
+    return;
+  }
+
+  const uint32_t elapsed_ms = LocalUserElapsedMs();
+  if (snapshot.initialized && elapsed_ms < snapshot.next_activation_ms) {
+    return;
+  }
+
+  const uint32_t max_count = MaxLocalUserCount();
+  const auto& activation_ms = LocalUserActivationMs();
+  uint32_t active_mask = 0;
+  uint32_t active_count = 0;
+  for (uint32_t user = 0; user < max_count; ++user) {
+    bool active = false;
+    if (activation_ms.empty()) {
+      active = true;
+    } else if (user < activation_ms.size()) {
+      active = elapsed_ms >= activation_ms[user];
+    } else {
+      active = user == 0;
+    }
+
+    if (active) {
+      active_mask |= 1u << user;
+      ++active_count;
+    }
+  }
