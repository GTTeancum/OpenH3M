+void WriteBigEndian16(uint8_t* output, uint16_t value) {
+  output[0] = static_cast<uint8_t>(value >> 8);
+  output[1] = static_cast<uint8_t>(value);
+}
+
+uint32_t AddChecksumBytes(uint32_t sum, std::span<const uint8_t> bytes) {
+  size_t offset = 0;
+  for (; offset + 1 < bytes.size(); offset += 2) {
+    sum += (static_cast<uint16_t>(bytes[offset]) << 8) | bytes[offset + 1];
+  }
+  if (offset < bytes.size()) {
+    sum += static_cast<uint16_t>(bytes[offset]) << 8;
+  }
+  return sum;
+}
+
+uint16_t FoldChecksum(uint32_t sum) {
+  while (sum >> 16) {
+    sum = (sum & 0xFFFF) + (sum >> 16);
+  }
+  return static_cast<uint16_t>(sum);
+}
+
+std::vector<uint8_t> MakeFrame(std::span<const uint8_t> payload, bool vlan = false) {
+  const size_t ip_offset = vlan ? 18 : 14;
+  std::vector<uint8_t> frame(ip_offset + 20 + 8 + payload.size());
+  const std::array<uint8_t, 6> destination = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
+  const std::array<uint8_t, 6> source = {0x02, 0x00, 0x00, 0x00, 0x00, 0x01};
+  std::copy(destination.begin(), destination.end(), frame.begin());
+  std::copy(source.begin(), source.end(), frame.begin() + 6);
+  if (vlan) {
+    WriteBigEndian16(frame.data() + 12, 0x8100);
+    WriteBigEndian16(frame.data() + 14, 1);
+    WriteBigEndian16(frame.data() + 16, 0x0800);
+  } else {
+    WriteBigEndian16(frame.data() + 12, 0x0800);
+  }
+
+  uint8_t* ip = frame.data() + ip_offset;
+  ip[0] = 0x45;
+  WriteBigEndian16(ip + 2, static_cast<uint16_t>(20 + 8 + payload.size()));
+  WriteBigEndian16(ip + 4, 0xBEEF);
+  ip[8] = 64;
+  ip[9] = 17;
+  ip[15] = 1;
+  std::fill(ip + 16, ip + 20, 0xFF);
+
+  uint8_t* udp = ip + 20;
+  WriteBigEndian16(udp, 3074);
+  WriteBigEndian16(udp + 2, 3074);
+  WriteBigEndian16(udp + 4, static_cast<uint16_t>(8 + payload.size()));
+  std::copy(payload.begin(), payload.end(), udp + 8);
+  return frame;
+}
+
+TEST_CASE("System Link raw parser accepts filtered Ethernet UDP frames") {
+  const std::array<uint8_t, 5> payload = {1, 2, 3, 4, 5};
+  const auto frame = MakeFrame(payload);
+  SystemLinkRawPacket packet;
+
+  REQUIRE(ParseSystemLinkRawFrame(frame, &packet));
+  CHECK(packet.frame_size == frame.size());
+  CHECK(packet.ipv4_identification == 0xBEEF);
+  CHECK(packet.payload == std::vector<uint8_t>(payload.begin(), payload.end()));
+  CHECK(packet.source_mac == std::array<uint8_t, 6>{0x02, 0x00, 0x00, 0x00, 0x00, 0x01});
+}
