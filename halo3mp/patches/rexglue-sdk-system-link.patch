@@ -0,0 +1,153 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+#include "kernel/xam/xnet_system_link_transport.h"
+
+namespace rex::kernel::xam {
+namespace {
+
+void WriteBigEndian16(uint8_t* output, uint16_t value) {
+  output[0] = static_cast<uint8_t>(value >> 8);
+  output[1] = static_cast<uint8_t>(value);
+}
+
+uint32_t AddChecksumBytes(uint32_t sum, std::span<const uint8_t> bytes) {
+  size_t offset = 0;
+  for (; offset + 1 < bytes.size(); offset += 2) {
+    sum += (static_cast<uint16_t>(bytes[offset]) << 8) | bytes[offset + 1];
+  }
+  if (offset < bytes.size()) {
+    sum += static_cast<uint16_t>(bytes[offset]) << 8;
+  }
+  return sum;
+}
+
+uint16_t FoldChecksum(uint32_t sum) {
+  while (sum >> 16) {
+    sum = (sum & 0xFFFF) + (sum >> 16);
+  }
+  return static_cast<uint16_t>(sum);
+}
+
+std::vector<uint8_t> MakeFrame(std::span<const uint8_t> payload,
+                               bool vlan = false) {
+  const size_t ip_offset = vlan ? 18 : 14;
+  std::vector<uint8_t> frame(ip_offset + 20 + 8 + payload.size());
+  const std::array<uint8_t, 6> destination = {0xFF, 0xFF, 0xFF,
+                                               0xFF, 0xFF, 0xFF};
+  const std::array<uint8_t, 6> source = {0x02, 0x00, 0x00,
+                                         0x00, 0x00, 0x01};
+  std::copy(destination.begin(), destination.end(), frame.begin());
+  std::copy(source.begin(), source.end(), frame.begin() + 6);
+  if (vlan) {
+    WriteBigEndian16(frame.data() + 12, 0x8100);
+    WriteBigEndian16(frame.data() + 14, 1);
+    WriteBigEndian16(frame.data() + 16, 0x0800);
+  } else {
+    WriteBigEndian16(frame.data() + 12, 0x0800);
+  }
+
+  uint8_t* ip = frame.data() + ip_offset;
+  ip[0] = 0x45;
+  WriteBigEndian16(ip + 2, static_cast<uint16_t>(20 + 8 + payload.size()));
+  ip[8] = 64;
+  ip[9] = 17;
+  ip[15] = 1;
+  std::fill(ip + 16, ip + 20, 0xFF);
+
+  uint8_t* udp = ip + 20;
+  WriteBigEndian16(udp, 3074);
+  WriteBigEndian16(udp + 2, 3074);
+  WriteBigEndian16(udp + 4, static_cast<uint16_t>(8 + payload.size()));
+  std::copy(payload.begin(), payload.end(), udp + 8);
+  return frame;
+}
+
+TEST_CASE("System Link raw parser accepts filtered Ethernet UDP frames") {
+  const std::array<uint8_t, 5> payload = {1, 2, 3, 4, 5};
+  const auto frame = MakeFrame(payload);
+  SystemLinkRawPacket packet;
+
+  REQUIRE(ParseSystemLinkRawFrame(frame, &packet));
+  CHECK(packet.frame_size == frame.size());
+  CHECK(packet.payload == std::vector<uint8_t>(payload.begin(), payload.end()));
+  CHECK(packet.source_mac ==
+        std::array<uint8_t, 6>{0x02, 0x00, 0x00, 0x00, 0x00, 0x01});
+}
+
+TEST_CASE("System Link raw parser accepts an Ethernet VLAN tag") {
+  const std::array<uint8_t, 1> payload = {0xA5};
+  SystemLinkRawPacket packet;
+  CHECK(ParseSystemLinkRawFrame(MakeFrame(payload, true), &packet));
+  CHECK(packet.payload.size() == 1);
+}
+
+TEST_CASE("System Link raw parser classifies Xbox 360 title beacons") {
+  std::array<uint8_t, 45> payload{};
+  payload[0] = 0x48;
+  payload[20] = 0xE6;
+  payload[21] = 0x07;
+  payload[22] = 0x53;
+  payload[23] = 0x4D;
+  payload[24] = 46;
+
+  SystemLinkRawPacket packet;
+  REQUIRE(ParseSystemLinkRawFrame(MakeFrame(payload), &packet));
+  CHECK(packet.payload_kind == SystemLinkRawPayloadKind::kBroadcastVersion);
+  CHECK(packet.title_id == 0x4D5307E6);
+  CHECK(packet.broadcast_version == 46);
+}
+
+TEST_CASE("System Link raw frame builder round trips payload and addressing") {
+  const std::array<uint8_t, 6> source = {0x02, 0x01, 0x02,
+                                         0x03, 0x04, 0x05};
+  const std::array<uint8_t, 6> destination = {0x06, 0x07, 0x08,
+                                              0x09, 0x0A, 0x0B};
+  const std::array<uint8_t, 5> payload = {1, 2, 3, 4, 5};
+  std::vector<uint8_t> frame;
+  REQUIRE(BuildSystemLinkRawFrame(source, destination, payload, &frame));
+
+  SystemLinkRawPacket packet;
+  REQUIRE(ParseSystemLinkRawFrame(frame, &packet));
+  CHECK(packet.source_mac == source);
+  CHECK(packet.destination_mac == destination);
+  CHECK(packet.payload == std::vector<uint8_t>(payload.begin(), payload.end()));
+
+  constexpr size_t kEthernetHeaderSize = 14;
+  constexpr size_t kIpv4HeaderSize = 20;
+  constexpr size_t kUdpHeaderSize = 8;
+  const uint8_t* ip = frame.data() + kEthernetHeaderSize;
+  const uint8_t* udp = ip + kIpv4HeaderSize;
+  CHECK(FoldChecksum(AddChecksumBytes(
+            0, std::span<const uint8_t>(ip, kIpv4HeaderSize))) == 0xFFFF);
+
+  uint32_t udp_sum = AddChecksumBytes(
+      0, std::span<const uint8_t>(ip + 12, 8));
+  udp_sum += ip[9];
+  udp_sum += static_cast<uint16_t>(kUdpHeaderSize + payload.size());
+  udp_sum = AddChecksumBytes(
+      udp_sum,
+      std::span<const uint8_t>(udp, kUdpHeaderSize + payload.size()));
+  CHECK(FoldChecksum(udp_sum) == 0xFFFF);
+}
+
+TEST_CASE("System Link raw parser rejects unrelated and truncated traffic") {
+  const std::array<uint8_t, 3> payload = {1, 2, 3};
+  auto frame = MakeFrame(payload);
+  SystemLinkRawPacket packet;
+
+  frame[14 + 12] = 10;
+  CHECK_FALSE(ParseSystemLinkRawFrame(frame, &packet));
+
+  frame = MakeFrame(payload);
+  frame.resize(frame.size() - 1);
+  CHECK_FALSE(ParseSystemLinkRawFrame(frame, &packet));
+}
