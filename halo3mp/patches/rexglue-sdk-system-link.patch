+constexpr uint16_t kEtherTypeIpv4 = 0x0800;
+constexpr uint16_t kEtherTypeVlan = 0x8100;
+constexpr uint16_t kEtherTypeProviderVlan = 0x88A8;
+constexpr uint8_t kIpProtocolUdp = 17;
+constexpr uint16_t kSystemLinkPort = 3074;
+constexpr size_t kXspPrefixSize = 4;
+constexpr size_t kXspVersionSize = 12;
+constexpr size_t kXspBlockCountSize = 1;
+constexpr size_t kXspTailSize = 12;
+constexpr size_t kXspAuthenticatedTrailerSize = 24;
+constexpr size_t kXspMinimumSize =
+    kXspPrefixSize + kXspVersionSize + kXspBlockCountSize + kXspTailSize;
+constexpr uint16_t kDefaultTitlePort = 1000;
+
+constexpr std::array<uint8_t, 16> kRetailRoamableObfuscationKey = {
+    0xE1, 0xBC, 0x15, 0x9C, 0x73, 0xB1, 0xEA, 0xE9, 0xAB, 0x31, 0x70, 0xF3, 0xAD, 0x47, 0xEB, 0xF3,
+};
+
+uint16_t ReadBigEndian16(const uint8_t* value) {
+  return static_cast<uint16_t>((static_cast<uint16_t>(value[0]) << 8) | value[1]);
+}
+
+uint32_t ReadLittleEndian32(const uint8_t* value) {
+  return static_cast<uint32_t>(value[0]) | (static_cast<uint32_t>(value[1]) << 8) |
+         (static_cast<uint32_t>(value[2]) << 16) | (static_cast<uint32_t>(value[3]) << 24);
+}
+
+uint16_t ReadLittleEndian16(const uint8_t* value) {
+  return static_cast<uint16_t>(value[0] | (static_cast<uint16_t>(value[1]) << 8));
+}
+
+uint64_t ReadBigEndian64(const uint8_t* value) {
+  uint64_t result = 0;
+  for (size_t i = 0; i < 8; ++i) {
+    result = (result << 8) | value[i];
+  }
+  return result;
+}
+
+void WriteBigEndian16(uint8_t* output, uint16_t value) {
+  output[0] = static_cast<uint8_t>(value >> 8);
+  output[1] = static_cast<uint8_t>(value);
+}
+
+void WriteBigEndian64(uint8_t* output, uint64_t value) {
+  for (size_t i = 0; i < 8; ++i) {
+    output[7 - i] = static_cast<uint8_t>(value);
+    value >>= 8;
+  }
+}
+
+void WriteLittleEndian16(uint8_t* output, uint16_t value) {
+  output[0] = static_cast<uint8_t>(value);
+  output[1] = static_cast<uint8_t>(value >> 8);
+}
+
+void WriteLittleEndian32(uint8_t* output, uint32_t value) {
+  output[0] = static_cast<uint8_t>(value);
+  output[1] = static_cast<uint8_t>(value >> 8);
+  output[2] = static_cast<uint8_t>(value >> 16);
+  output[3] = static_cast<uint8_t>(value >> 24);
+}
+
+std::array<uint8_t, 20> HmacSha1(std::span<const uint8_t> key, std::span<const uint8_t> first,
+                                 std::span<const uint8_t> second = {}) {
+  std::array<uint8_t, 64> inner_pad{};
+  std::array<uint8_t, 64> outer_pad{};
+  inner_pad.fill(0x36);
+  outer_pad.fill(0x5C);
+  for (size_t i = 0; i < key.size(); ++i) {
+    inner_pad[i] ^= key[i];
+    outer_pad[i] ^= key[i];
+  }
+
+  sha1::SHA1 inner;
+  inner.processBytes(inner_pad.data(), inner_pad.size());
+  inner.processBytes(first.data(), first.size());
+  if (!second.empty()) {
+    inner.processBytes(second.data(), second.size());
+  }
+  std::array<uint8_t, 20> inner_digest{};
+  inner.finalize(inner_digest.data());
+
+  sha1::SHA1 outer;
+  outer.processBytes(outer_pad.data(), outer_pad.size());
+  outer.processBytes(inner_digest.data(), inner_digest.size());
+  std::array<uint8_t, 20> digest{};
+  outer.finalize(digest.data());
+  return digest;
+}
+
+std::array<uint8_t, 8> CalculateBroadcastIv(const std::array<uint8_t, 8>& seed, uint32_t sequence) {
+  const uint64_t first = static_cast<uint64_t>(ReadLittleEndian32(seed.data())) * sequence;
+  const uint64_t second = static_cast<uint64_t>(ReadLittleEndian32(seed.data() + 4)) * sequence;
+  const uint32_t first_low = static_cast<uint32_t>(first);
+  const uint32_t first_high = static_cast<uint32_t>(first >> 32);
+  const uint32_t second_low = static_cast<uint32_t>(second);
+  const uint32_t second_high = static_cast<uint32_t>(second >> 32);
+
+  std::array<uint8_t, 8> iv{};
+  WriteLittleEndian32(iv.data(), first_low ^ second_high);
+  WriteLittleEndian32(iv.data() + 4, first_high ^ second_low);
+  return iv;
+}
+
+void CryptBroadcast(std::span<const uint8_t> input, const SystemLinkBroadcastKeys& keys,
+                    uint32_t sequence, bool encrypt, uint8_t* output) {
+  const auto iv = CalculateBroadcastIv(keys.iv_seed, sequence);
+  DES3 des(ReadBigEndian64(keys.encryption.data()), ReadBigEndian64(keys.encryption.data() + 8),
+           ReadBigEndian64(keys.encryption.data() + 16));
+  uint64_t feedback = ReadBigEndian64(iv.data());
+  for (size_t offset = 0; offset < input.size(); offset += 8) {
+    const uint64_t block = ReadBigEndian64(input.data() + offset);
+    if (encrypt) {
+      feedback = des.encrypt(block ^ feedback);
+      WriteBigEndian64(output + offset, feedback);
+    } else {
+      WriteBigEndian64(output + offset, des.decrypt(block) ^ feedback);
+      feedback = block;
+    }
+  }
+}
+
+uint8_t DecodeExtraEncryptedBytes(uint8_t xflags) {
+  const uint8_t encoded = xflags >> 4;
+  return static_cast<uint8_t>((encoded >> 1) | ((encoded & 1) << 3));
+}
+
+uint8_t EncodeExtraEncryptedBytes(uint8_t count) {
+  return static_cast<uint8_t>(((count & 7) << 1) | ((count >> 3) & 1));
+}
+
+bool ConstantTimeEqual(std::span<const uint8_t> left, std::span<const uint8_t> right) {
+  if (left.size() != right.size()) {
+    return false;
+  }
+  uint8_t difference = 0;
+  for (size_t i = 0; i < left.size(); ++i) {
+    difference |= left[i] ^ right[i];
+  }
+  return difference == 0;
+}
+
+size_t PortEncodingSize(uint16_t source_port, uint16_t destination_port) {
+  if (source_port == kDefaultTitlePort && destination_port == kDefaultTitlePort) {
+    return 0;
+  }
+  if (source_port >= kDefaultTitlePort && source_port < 1256 &&
+      destination_port >= kDefaultTitlePort && destination_port < 1256) {
+    return 1;
+  }
+  return 2;
+}
+
+uint32_t AddChecksumBytes(uint32_t sum, std::span<const uint8_t> bytes) {
+  size_t offset = 0;
+  while (offset + 1 < bytes.size()) {
+    sum += ReadBigEndian16(bytes.data() + offset);
+    offset += 2;
+  }
+  if (offset < bytes.size()) {
+    sum += static_cast<uint16_t>(bytes[offset]) << 8;
+  }
+  return sum;
+}
+
+uint16_t FinishChecksum(uint32_t sum) {
+  while (sum >> 16) {
+    sum = (sum & 0xFFFF) + (sum >> 16);
+  }
+  return static_cast<uint16_t>(~sum);
+}
+
+void ClassifySystemLinkPayload(SystemLinkRawPacket* packet) {
+  // Xbox 360 Find Game emits this fixed-size authenticated title/version
+  // beacon. Keep the remaining bytes opaque until its authenticator is
+  // implemented and verified.
+  constexpr size_t kBroadcastVersionSize = 45;
+  constexpr uint32_t kBroadcastVersionMarker = 0x48;
+  constexpr size_t kTitleIdOffset = 20;
+  constexpr size_t kBroadcastVersionOffset = 24;
+  constexpr size_t kSequenceOffset = 33;
+  if (packet->payload.size() == kBroadcastVersionSize &&
+      ReadLittleEndian32(packet->payload.data()) == kBroadcastVersionMarker) {
+    packet->payload_kind = SystemLinkRawPayloadKind::kBroadcastVersion;
+    packet->broadcast_sequence = ReadLittleEndian16(packet->payload.data() + kSequenceOffset);
+    packet->title_id = ReadLittleEndian32(packet->payload.data() + kTitleIdOffset);
+    packet->broadcast_version =
+        ReadLittleEndian32(packet->payload.data() + kBroadcastVersionOffset);
+    packet->system_version =
+        ReadLittleEndian32(packet->payload.data() + kBroadcastVersionOffset + 4);
+  }
+}
+
+}  // namespace
+
+SystemLinkBroadcastKeys DeriveSystemLinkBroadcastKeys(
+    const std::array<uint8_t, 16>& title_lan_key) {
+  std::array<std::array<uint8_t, 20>, 3> digests{};
+  std::array<uint8_t, 17> input{};
+  std::copy(title_lan_key.begin(), title_lan_key.end(), input.begin() + 1);
+  for (uint8_t prefix = 0; prefix < digests.size(); ++prefix) {
+    input[0] = prefix;
+    digests[prefix] = HmacSha1(kRetailRoamableObfuscationKey, input);
+  }
+
+  SystemLinkBroadcastKeys keys;
+  std::copy_n(digests[0].begin(), keys.authentication.size(), keys.authentication.begin());
+  std::copy(digests[0].begin() + 16, digests[0].end(), keys.encryption.begin());
+  std::copy(digests[1].begin(), digests[1].end(), keys.encryption.begin() + 4);
+  DES::set_parity(keys.encryption.data(), static_cast<int>(keys.encryption.size()),
+                  keys.encryption.data());
+  std::copy_n(digests[2].begin(), keys.iv_seed.size(), keys.iv_seed.begin());
+  return keys;
+}
+
+bool DecodeSystemLinkBroadcast(std::span<const uint8_t> payload,
+                               const SystemLinkBroadcastKeys& keys,
+                               SystemLinkBroadcastDatagram* datagram,
+                               SystemLinkBroadcastDecodeDiagnostics* diagnostics) {
+  if (diagnostics) {
+    *diagnostics = {};
+  }
+  if (!datagram || payload.size() < kXspMinimumSize || payload[1] != 0 || payload[2] != 0 ||
+      payload[3] != 0) {
+    return false;
+  }
+
+  const uint8_t protocol = payload[0] & 0x0F;
+  if (protocol < 7 || protocol > 9) {
+    return false;
+  }
+  const size_t port_size = protocol - 7;
+  const size_t encoded_ports_size = port_size * 2;
+  const uint8_t extra_encrypted_bytes = DecodeExtraEncryptedBytes(payload[0]);
+  if (extra_encrypted_bytes < encoded_ports_size) {
+    return false;
+  }
+
+  const size_t block_count_offset = payload.size() - kXspTailSize - 1;
+  const size_t encrypted_size = static_cast<size_t>(payload[block_count_offset]) * 8;
+  const size_t version_offset = kXspPrefixSize + encrypted_size;
+  if (!encrypted_size || version_offset + kXspVersionSize != block_count_offset ||
+      encrypted_size < extra_encrypted_bytes ||
+      version_offset + kXspAuthenticatedTrailerSize > payload.size()) {
+    return false;
+  }
+
+  const size_t tail_offset = block_count_offset + 1;
+  const uint16_t sequence = ReadLittleEndian16(payload.data() + tail_offset);
+  std::vector<uint8_t> authenticated(payload.begin(), payload.end());
+  WriteLittleEndian16(authenticated.data() + tail_offset + 2, sequence);
+  std::copy_n(payload.begin(), kXspPrefixSize, authenticated.begin() + tail_offset + 4);
+  std::fill_n(authenticated.begin() + tail_offset + 8, 4, 0);
+  const auto digest = HmacSha1(
+      keys.authentication,
+      std::span<const uint8_t>(authenticated.data() + version_offset, kXspAuthenticatedTrailerSize),
+      payload.subspan(kXspPrefixSize, encrypted_size));
+  if (!ConstantTimeEqual(std::span<const uint8_t>(digest.data(), 10),
+                         payload.subspan(tail_offset + 2, 10))) {
+    if (diagnostics) {
+      diagnostics->status = SystemLinkBroadcastDecodeStatus::kAuthenticationFailed;
+    }
+    return false;
+  }
+
+  std::vector<uint8_t> decrypted(encrypted_size);
+  const uint32_t full_sequence =
+      static_cast<uint32_t>(sequence) | (static_cast<uint32_t>(sequence) << 16);
+  CryptBroadcast(payload.subspan(kXspPrefixSize, encrypted_size), keys, full_sequence, false,
+                 decrypted.data());
+
+  const size_t data_size = encrypted_size - extra_encrypted_bytes;
+  const size_t ports_offset = encrypted_size - encoded_ports_size;
+  if (!std::all_of(decrypted.begin() + data_size, decrypted.begin() + ports_offset,
+                   [](uint8_t value) { return value == 0; })) {
+    if (diagnostics) {
+      diagnostics->status = SystemLinkBroadcastDecodeStatus::kInvalidPadding;
+    }
+    return false;
+  }
+
+  uint16_t source_port = kDefaultTitlePort;
+  uint16_t destination_port = kDefaultTitlePort;
+  if (port_size == 1) {
+    source_port = static_cast<uint16_t>(kDefaultTitlePort + decrypted[ports_offset]);
+    destination_port = static_cast<uint16_t>(kDefaultTitlePort + decrypted[ports_offset + 1]);
+  } else if (port_size == 2) {
+    source_port = ReadBigEndian16(decrypted.data() + ports_offset);
+    destination_port = ReadBigEndian16(decrypted.data() + ports_offset + 2);
+  }
+
+  datagram->source_port = source_port;
+  datagram->destination_port = destination_port;
+  datagram->sequence = sequence;
+  datagram->title_id = ReadLittleEndian32(payload.data() + version_offset);
+  datagram->title_version = ReadLittleEndian32(payload.data() + version_offset + 4);
+  datagram->system_version = ReadLittleEndian32(payload.data() + version_offset + 8);
+  datagram->data.assign(decrypted.begin(), decrypted.begin() + data_size);
+  if (diagnostics) {
+    diagnostics->status = SystemLinkBroadcastDecodeStatus::kSuccess;
+  }
+  return true;
+}
+
+bool DiagnoseSystemLinkBroadcastAuthentication(std::span<const uint8_t> payload,
+                                               const SystemLinkBroadcastKeys& keys,
+                                               SystemLinkBroadcastDecodeDiagnostics* diagnostics) {
+  if (!diagnostics || payload.size() < kXspMinimumSize || payload[1] != 0 || payload[2] != 0 ||
+      payload[3] != 0) {
+    return false;
+  }
+
+  const size_t block_count_offset = payload.size() - kXspTailSize - kXspBlockCountSize;
+  const size_t encrypted_size = static_cast<size_t>(payload[block_count_offset]) * 8;
+  const size_t version_offset = kXspPrefixSize + encrypted_size;
+  const size_t tail_offset = block_count_offset + kXspBlockCountSize;
+  if (!encrypted_size || version_offset + kXspVersionSize != block_count_offset ||
+      tail_offset + kXspTailSize != payload.size()) {
+    return false;
+  }
+
+  const uint16_t sequence = ReadLittleEndian16(payload.data() + tail_offset);
+  for (uint8_t mutation = 0; mutation < 6; ++mutation) {
+    std::vector<uint8_t> authenticated(payload.begin(), payload.end());
+    if (mutation == 5) {
+      // Retain the transmitted tail exactly for the final diagnostic candidate.
+    } else {
+      if (mutation == 2 || mutation == 3) {
+        WriteBigEndian16(authenticated.data() + tail_offset + 2, sequence);
+      } else {
+        WriteLittleEndian16(authenticated.data() + tail_offset + 2, sequence);
+      }
+
+      if (mutation == 1 || mutation == 3) {
+        std::reverse_copy(payload.begin(), payload.begin() + kXspPrefixSize,
+                          authenticated.begin() + tail_offset + 4);
+      } else if (mutation == 4) {
+        std::fill_n(authenticated.begin() + tail_offset + 4, kXspPrefixSize, 0);
+      } else {
+        std::copy_n(payload.begin(), kXspPrefixSize, authenticated.begin() + tail_offset + 4);
+      }
+      std::fill_n(authenticated.begin() + tail_offset + 8, 4, 0);
+    }
+
+    const size_t first_offset_begin = version_offset >= 4 ? version_offset - 4 : 0;
+    const size_t first_offset_end = std::min(version_offset + 4, payload.size());
+    for (size_t first_offset = first_offset_begin; first_offset <= first_offset_end;
+         ++first_offset) {
+      for (size_t first_size = 20; first_size <= 28; ++first_size) {
+        if (first_offset + first_size > payload.size()) {
+          continue;
+        }
+        for (size_t second_offset : {size_t{0}, kXspPrefixSize}) {
+          for (size_t second_size : {encrypted_size, encrypted_size + kXspPrefixSize}) {
+            if (second_offset + second_size > payload.size()) {
+              continue;
+            }
+            const auto first =
+                std::span<const uint8_t>(authenticated).subspan(first_offset, first_size);
+            const auto second = payload.subspan(second_offset, second_size);
+            for (bool reversed : {false, true}) {
+              const auto digest = reversed ? HmacSha1(keys.authentication, second, first)
+                                           : HmacSha1(keys.authentication, first, second);
+              if (!ConstantTimeEqual(std::span<const uint8_t>(digest.data(), 10),
+                                     payload.subspan(tail_offset + 2, 10))) {
+                continue;
+              }
+              diagnostics->alternative_authentication_matched = true;
+              diagnostics->authentication_mutation = mutation;
+              diagnostics->authentication_first_offset = static_cast<uint8_t>(first_offset);
+              diagnostics->authentication_first_size = static_cast<uint8_t>(first_size);
+              diagnostics->authentication_second_offset = static_cast<uint8_t>(second_offset);
+              diagnostics->authentication_second_size = static_cast<uint8_t>(second_size);
+              diagnostics->authentication_inputs_reversed = reversed;
+              return true;
+            }
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
+
+bool EncodeSystemLinkBroadcast(std::span<const uint8_t> data, uint16_t source_port,
+                               uint16_t destination_port, uint32_t title_id, uint32_t title_version,
+                               uint32_t system_version, uint16_t sequence,
+                               const SystemLinkBroadcastKeys& keys, std::vector<uint8_t>* payload) {
+  if (!payload || !source_port || !destination_port) {
+    return false;
+  }
+
+  const size_t port_size = PortEncodingSize(source_port, destination_port);
+  const size_t encoded_ports_size = port_size * 2;
+  const size_t unaligned_size = data.size() + encoded_ports_size;
+  const size_t encrypted_size = (unaligned_size + 7) & ~size_t{7};
+  if (!encrypted_size || encrypted_size / 8 > UINT8_MAX) {
+    return false;
+  }
+  const size_t extra_encrypted_bytes = encrypted_size - data.size();
+  if (extra_encrypted_bytes > 15) {
+    return false;
+  }
+
+  const uint8_t xflags = static_cast<uint8_t>(
+      (EncodeExtraEncryptedBytes(static_cast<uint8_t>(extra_encrypted_bytes)) << 4) |
+      (7 + port_size));
+  const size_t version_offset = kXspPrefixSize + encrypted_size;
+  const size_t block_count_offset = version_offset + kXspVersionSize;
+  const size_t tail_offset = block_count_offset + 1;
+  payload->assign(tail_offset + kXspTailSize, 0);
+  (*payload)[0] = xflags;
+
+  std::vector<uint8_t> plaintext(encrypted_size, 0);
+  std::copy(data.begin(), data.end(), plaintext.begin());
+  const size_t ports_offset = encrypted_size - encoded_ports_size;
+  if (port_size == 1) {
+    plaintext[ports_offset] = static_cast<uint8_t>(source_port - kDefaultTitlePort);
+    plaintext[ports_offset + 1] = static_cast<uint8_t>(destination_port - kDefaultTitlePort);
+  } else if (port_size == 2) {
+    WriteBigEndian16(plaintext.data() + ports_offset, source_port);
+    WriteBigEndian16(plaintext.data() + ports_offset + 2, destination_port);
+  }
+
+  const uint32_t full_sequence =
+      static_cast<uint32_t>(sequence) | (static_cast<uint32_t>(sequence) << 16);
+  CryptBroadcast(plaintext, keys, full_sequence, true, payload->data() + kXspPrefixSize);
+  WriteLittleEndian32(payload->data() + version_offset, title_id);
+  WriteLittleEndian32(payload->data() + version_offset + 4, title_version);
+  WriteLittleEndian32(payload->data() + version_offset + 8, system_version);
+  (*payload)[block_count_offset] = static_cast<uint8_t>(encrypted_size / 8);
+
+  WriteLittleEndian16(payload->data() + tail_offset, sequence);
+  WriteLittleEndian16(payload->data() + tail_offset + 2, sequence);
+  std::copy_n(payload->begin(), kXspPrefixSize, payload->begin() + tail_offset + 4);
+  const auto digest = HmacSha1(
+      keys.authentication,
+      std::span<const uint8_t>(payload->data() + version_offset, kXspAuthenticatedTrailerSize),
+      std::span<const uint8_t>(payload->data() + kXspPrefixSize, encrypted_size));
+  std::copy_n(digest.begin(), 10, payload->begin() + tail_offset + 2);
+  return true;
+}
+
+bool BuildSystemLinkRawFrame(const std::array<uint8_t, 6>& source_mac,
+                             const std::array<uint8_t, 6>& destination_mac,
+                             std::span<const uint8_t> payload, std::vector<uint8_t>* frame) {
+  constexpr size_t kEthernetHeaderSize = 14;
+  constexpr size_t kIpv4HeaderSize = 20;
+  constexpr size_t kUdpHeaderSize = 8;
+  if (!frame || payload.size() > UINT16_MAX - kIpv4HeaderSize - kUdpHeaderSize) {
+    return false;
+  }
+
+  const uint16_t udp_size = static_cast<uint16_t>(kUdpHeaderSize + payload.size());
+  const uint16_t ip_size = static_cast<uint16_t>(kIpv4HeaderSize + udp_size);
+  frame->assign(kEthernetHeaderSize + ip_size, 0);
+
+  std::copy(destination_mac.begin(), destination_mac.end(), frame->begin());
+  std::copy(source_mac.begin(), source_mac.end(), frame->begin() + 6);
+  WriteBigEndian16(frame->data() + 12, kEtherTypeIpv4);
+
+  uint8_t* ip = frame->data() + kEthernetHeaderSize;
+  ip[0] = 0x45;
+  WriteBigEndian16(ip + 2, ip_size);
+  ip[8] = 64;
+  ip[9] = kIpProtocolUdp;
+  ip[15] = 1;
+  std::fill(ip + 16, ip + 20, 0xFF);
+  WriteBigEndian16(
+      ip + 10, FinishChecksum(AddChecksumBytes(0, std::span<const uint8_t>(ip, kIpv4HeaderSize))));
+
+  uint8_t* udp = ip + kIpv4HeaderSize;
+  WriteBigEndian16(udp, kSystemLinkPort);
+  WriteBigEndian16(udp + 2, kSystemLinkPort);
+  WriteBigEndian16(udp + 4, udp_size);
+  std::copy(payload.begin(), payload.end(), udp + kUdpHeaderSize);
+
+  uint32_t udp_checksum = 0;
+  udp_checksum = AddChecksumBytes(udp_checksum, std::span<const uint8_t>(ip + 12, 8));
+  udp_checksum += kIpProtocolUdp;
+  udp_checksum += udp_size;
+  udp_checksum = AddChecksumBytes(udp_checksum, std::span<const uint8_t>(udp, udp_size));
+  uint16_t checksum = FinishChecksum(udp_checksum);
+  WriteBigEndian16(udp + 6, checksum ? checksum : 0xFFFF);
+  return true;
+}
+
+bool ParseSystemLinkRawFrame(std::span<const uint8_t> frame, SystemLinkRawPacket* packet) {
+  if (!packet || frame.size() < 14) {
+    return false;
+  }
+
+  size_t ip_offset = 14;
+  uint16_t ether_type = ReadBigEndian16(frame.data() + 12);
+  for (uint32_t vlan_count = 0;
+       vlan_count < 2 && (ether_type == kEtherTypeVlan || ether_type == kEtherTypeProviderVlan);
+       ++vlan_count) {
+    if (frame.size() < ip_offset + 4) {
+      return false;
+    }
+    ether_type = ReadBigEndian16(frame.data() + ip_offset + 2);
+    ip_offset += 4;
+  }
+  if (ether_type != kEtherTypeIpv4 || frame.size() < ip_offset + 20) {
+    return false;
+  }
+
+  const uint8_t* ip = frame.data() + ip_offset;
+  const uint8_t version = ip[0] >> 4;
+  const size_t ip_header_size = static_cast<size_t>(ip[0] & 0x0F) * 4;
+  if (version != 4 || ip_header_size < 20 || frame.size() < ip_offset + ip_header_size + 8 ||
+      ip[9] != kIpProtocolUdp || ip[12] != 0 || ip[13] != 0 || ip[14] != 0 || ip[15] != 1) {
+    return false;
+  }
+
+  const size_t ip_total_size = ReadBigEndian16(ip + 2);
+  if (ip_total_size < ip_header_size + 8 || frame.size() < ip_offset + ip_total_size) {
+    return false;
+  }
+
+  const uint8_t* udp = ip + ip_header_size;
+  if (ReadBigEndian16(udp) != kSystemLinkPort || ReadBigEndian16(udp + 2) != kSystemLinkPort) {
+    return false;
+  }
+  const size_t udp_size = ReadBigEndian16(udp + 4);
+  if (udp_size < 8 || udp_size > ip_total_size - ip_header_size) {
+    return false;
+  }
+
+  std::copy_n(frame.data(), packet->destination_mac.size(), packet->destination_mac.begin());
+  std::copy_n(frame.data() + 6, packet->source_mac.size(), packet->source_mac.begin());
+  packet->frame_size = static_cast<uint32_t>(frame.size());
+  packet->ipv4_identification = ReadBigEndian16(ip + 4);
+  packet->payload.assign(udp + 8, udp + udp_size);
+  ClassifySystemLinkPayload(packet);
+  return true;
+}
+
+struct SystemLinkRawTransport::Impl {
+#if REX_PLATFORM_WIN32
+  using PcapHandle = void;
+  struct PcapAddress {
+    PcapAddress* next;
+    sockaddr* address;
+    sockaddr* netmask;
+    sockaddr* broadcast_address;
+    sockaddr* destination_address;
+  };
+  struct PcapInterface {
+    PcapInterface* next;
+    char* name;
+    char* description;
+    PcapAddress* addresses;
+    uint32_t flags;
+  };
+  struct PcapPacketHeader {
+    timeval timestamp;
+    uint32_t captured_length;
+    uint32_t original_length;
+  };
+  struct BpfProgram {
+    uint32_t instruction_count;
+    void* instructions;
+  };
+
+  using FindAllDevicesFn = int(__cdecl*)(PcapInterface**, char*);
+  using FreeAllDevicesFn = void(__cdecl*)(PcapInterface*);
+  using OpenLiveFn = PcapHandle*(__cdecl*)(const char*, int, int, int, char*);
+  using CloseFn = void(__cdecl*)(PcapHandle*);
+  using DataLinkFn = int(__cdecl*)(PcapHandle*);
+  using CompileFn = int(__cdecl*)(PcapHandle*, BpfProgram*, const char*, int, uint32_t);
+  using SetFilterFn = int(__cdecl*)(PcapHandle*, BpfProgram*);
+  using FreeCodeFn = void(__cdecl*)(BpfProgram*);
+  using SetNonBlockFn = int(__cdecl*)(PcapHandle*, int, char*);
+  using NextExFn = int(__cdecl*)(PcapHandle*, PcapPacketHeader**, const uint8_t**);
+  using SendPacketFn = int(__cdecl*)(PcapHandle*, const uint8_t*, int);
+  using GetErrorFn = char*(__cdecl*)(PcapHandle*);
+
+  HMODULE library = nullptr;
+  PcapHandle* capture = nullptr;
+  std::array<uint8_t, 6> local_mac{};
+  FindAllDevicesFn find_all_devices = nullptr;
+  FreeAllDevicesFn free_all_devices = nullptr;
+  OpenLiveFn open_live = nullptr;
+  CloseFn close = nullptr;
+  DataLinkFn data_link = nullptr;
+  CompileFn compile = nullptr;
+  SetFilterFn set_filter = nullptr;
+  FreeCodeFn free_code = nullptr;
+  SetNonBlockFn set_non_block = nullptr;
+  NextExFn next_ex = nullptr;
+  SendPacketFn send_packet = nullptr;
+  GetErrorFn get_error = nullptr;
+#endif
+};
+
+SystemLinkRawTransport::SystemLinkRawTransport() : impl_(std::make_unique<Impl>()) {}
+
+SystemLinkRawTransport::~SystemLinkRawTransport() {
+  Close();
+}
+
+bool SystemLinkRawTransport::Open(uint32_t local_ipv4, const std::array<uint8_t, 6>& local_mac,
+                                  std::string* error) {
+  Close();
+#if REX_PLATFORM_WIN32
+  constexpr size_t kPcapErrorBufferSize = 256;
+  constexpr int kEthernetDataLink = 1;
+  char error_buffer[kPcapErrorBufferSize]{};
+
+  impl_->library = LoadLibraryW(L"wpcap.dll");
+  if (!impl_->library) {
+    if (error) {
+      *error = "Npcap wpcap.dll is unavailable";
+    }
+    return false;
+  }
+
+#define REX_LOAD_PCAP_SYMBOL(member, type, symbol)                                      \
+  impl_->member = reinterpret_cast<Impl::type>(GetProcAddress(impl_->library, symbol)); \
+  if (!impl_->member) {                                                                 \
+    if (error) {                                                                        \
+      *error = "Npcap is missing " symbol;                                              \
+    }                                                                                   \
+    Close();                                                                            \
+    return false;                                                                       \
+  }
+
+  REX_LOAD_PCAP_SYMBOL(find_all_devices, FindAllDevicesFn, "pcap_findalldevs");
+  REX_LOAD_PCAP_SYMBOL(free_all_devices, FreeAllDevicesFn, "pcap_freealldevs");
+  REX_LOAD_PCAP_SYMBOL(open_live, OpenLiveFn, "pcap_open_live");
+  REX_LOAD_PCAP_SYMBOL(close, CloseFn, "pcap_close");
+  REX_LOAD_PCAP_SYMBOL(data_link, DataLinkFn, "pcap_datalink");
+  REX_LOAD_PCAP_SYMBOL(compile, CompileFn, "pcap_compile");
+  REX_LOAD_PCAP_SYMBOL(set_filter, SetFilterFn, "pcap_setfilter");
+  REX_LOAD_PCAP_SYMBOL(free_code, FreeCodeFn, "pcap_freecode");
+  REX_LOAD_PCAP_SYMBOL(set_non_block, SetNonBlockFn, "pcap_setnonblock");
+  REX_LOAD_PCAP_SYMBOL(next_ex, NextExFn, "pcap_next_ex");
+  REX_LOAD_PCAP_SYMBOL(send_packet, SendPacketFn, "pcap_sendpacket");
+  REX_LOAD_PCAP_SYMBOL(get_error, GetErrorFn, "pcap_geterr");
+#undef REX_LOAD_PCAP_SYMBOL
+
+  Impl::PcapInterface* interfaces = nullptr;
+  if (impl_->find_all_devices(&interfaces, error_buffer) != 0) {
+    if (error) {
+      *error = error_buffer[0] ? error_buffer : "Npcap adapter enumeration failed";
+    }
+    Close();
+    return false;
+  }
+
+  std::string adapter_name;
+  for (Impl::PcapInterface* interface = interfaces; interface && adapter_name.empty();
+       interface = interface->next) {
+    for (Impl::PcapAddress* address = interface->addresses; address; address = address->next) {
+      if (!address->address || address->address->sa_family != AF_INET) {
+        continue;
+      }
+      const auto* ipv4 = reinterpret_cast<const sockaddr_in*>(address->address);
+      if (ipv4->sin_addr.s_addr == local_ipv4 && interface->name) {
+        adapter_name = interface->name;
+        break;
+      }
+    }
+  }
+  impl_->free_all_devices(interfaces);
+  if (adapter_name.empty()) {
+    if (error) {
+      *error = "Npcap could not match the selected IPv4 adapter";
+    }
+    Close();
+    return false;
+  }
+
+  impl_->capture = impl_->open_live(adapter_name.c_str(), 2048, 0, 1, error_buffer);
+  if (!impl_->capture) {
+    if (error) {
+      *error = error_buffer[0] ? error_buffer : "Npcap adapter open failed";
+    }
+    Close();
+    return false;
+  }
+  if (impl_->data_link(impl_->capture) != kEthernetDataLink) {
+    if (error) {
+      *error = "Npcap adapter does not provide Ethernet frames";
+    }
+    Close();
+    return false;
+  }
+
+  char filter[192]{};
+  std::snprintf(filter, sizeof(filter),
+                "ip src host 0.0.0.1 and udp src port 3074 and udp dst port 3074 and "
+                "not ether src %02x:%02x:%02x:%02x:%02x:%02x",
+                local_mac[0], local_mac[1], local_mac[2], local_mac[3], local_mac[4], local_mac[5]);
+  Impl::BpfProgram program{};
+  if (impl_->compile(impl_->capture, &program, filter, 1, 0xFFFFFFFFu) != 0) {
+    if (error) {
+      *error = impl_->get_error(impl_->capture);
+    }
+    Close();
+    return false;
+  }
+  const int filter_result = impl_->set_filter(impl_->capture, &program);
+  impl_->free_code(&program);
+  if (filter_result != 0 || impl_->set_non_block(impl_->capture, 1, error_buffer) != 0) {
+    if (error) {
+      *error = error_buffer[0] ? error_buffer : impl_->get_error(impl_->capture);
+    }
+    Close();
+    return false;
+  }
+  impl_->local_mac = local_mac;
+  return true;
+#else
+  if (error) {
+    *error = "raw System Link transport is only available on Windows";
+  }
+  return false;
+#endif
+}
+
+void SystemLinkRawTransport::Close() {
+#if REX_PLATFORM_WIN32
+  if (impl_->capture && impl_->close) {
+    impl_->close(impl_->capture);
+  }
+  impl_->capture = nullptr;
+  if (impl_->library) {
+    FreeLibrary(impl_->library);
+  }
+  *impl_ = Impl{};
+#endif
+}
+
+bool SystemLinkRawTransport::is_open() const {
+#if REX_PLATFORM_WIN32
+  return impl_->capture != nullptr;
+#else
+  return false;
+#endif
+}
+
+size_t SystemLinkRawTransport::Poll(std::vector<SystemLinkRawPacket>* packets, size_t max_packets,
+                                    std::string* error) {
+  if (!packets || !max_packets) {
+    return 0;
+  }
+#if REX_PLATFORM_WIN32
+  if (!impl_->capture) {
+    return 0;
+  }
+  size_t accepted = 0;
+  while (accepted < max_packets) {
+    Impl::PcapPacketHeader* header = nullptr;
+    const uint8_t* data = nullptr;
+    const int result = impl_->next_ex(impl_->capture, &header, &data);
+    if (result == 0) {
+      break;
+    }
+    if (result < 0) {
+      if (error) {
+        *error = impl_->get_error(impl_->capture);
+      }
+      break;
+    }
+    if (!header || !data) {
+      continue;
+    }
+    SystemLinkRawPacket packet;
+    if (ParseSystemLinkRawFrame(std::span<const uint8_t>(data, header->captured_length), &packet)) {
+      packet.frame_size = header->original_length;
+      packets->push_back(std::move(packet));
+      ++accepted;
+    }
+  }
+  return accepted;
+#else
+  return 0;
+#endif
+}
+
+bool SystemLinkRawTransport::SendFrame(std::span<const uint8_t> frame, std::string* error) {
+#if REX_PLATFORM_WIN32
+  if (!impl_->capture || frame.empty() || frame.size() > INT_MAX) {
+    if (error) {
+      *error = "raw System Link transport is not open";
+    }
+    return false;
+  }
+  if (impl_->send_packet(impl_->capture, frame.data(), static_cast<int>(frame.size())) != 0) {
+    if (error) {
+      *error = impl_->get_error(impl_->capture);
+    }
+    return false;
+  }
+  return true;
+#else
+  if (error) {
+    *error = "raw System Link transport is only available on Windows";
+  }
+  return false;
+#endif
+}
+
+bool SystemLinkRawTransport::SendPayloadTo(const std::array<uint8_t, 6>& destination_mac,
+                                           std::span<const uint8_t> payload, std::string* error) {
+#if REX_PLATFORM_WIN32
+  std::vector<uint8_t> frame;
+  if (!BuildSystemLinkRawFrame(impl_->local_mac, destination_mac, payload, &frame)) {
+    if (error) {
+      *error = "raw System Link payload is too large";
+    }
+    return false;
+  }
+  return SendFrame(frame, error);
+#else
+  if (error) {
+    *error = "raw System Link transport is only available on Windows";
+  }
+  return false;
+#endif
+}
+
+}  // namespace rex::kernel::xam
