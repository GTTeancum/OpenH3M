+TEST_CASE("System Link raw parser rejects unrelated and truncated traffic") {
+  const std::array<uint8_t, 3> payload = {1, 2, 3};
+  auto frame = MakeFrame(payload);
+  SystemLinkRawPacket packet;
+
+  frame[14 + 12] = 10;
+  CHECK_FALSE(ParseSystemLinkRawFrame(frame, &packet));
+
+  frame = MakeFrame(payload);
+  frame.resize(frame.size() - 1);
+  CHECK_FALSE(ParseSystemLinkRawFrame(frame, &packet));
+}
