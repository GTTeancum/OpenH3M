+TEST_CASE("System Link broadcast codec rejects tampering and wrong keys") {
+  const std::array<uint8_t, 16> title_lan_key = {
+      0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
+      0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF,
+  };
+  const auto keys = DeriveSystemLinkBroadcastKeys(title_lan_key);
+  const std::array<uint8_t, 14> title_data{};
+  std::vector<uint8_t> payload;
+  REQUIRE(EncodeSystemLinkBroadcast(title_data, 1000, 1001, 0x4D5307E6, 46, 0x200A3200, 1, keys,
+                                    &payload));
+
+  SystemLinkBroadcastDatagram datagram;
+  SystemLinkBroadcastDecodeDiagnostics diagnostics;
+  payload[10] ^= 0x80;
+  CHECK_FALSE(DecodeSystemLinkBroadcast(payload, keys, &datagram, &diagnostics));
+  CHECK(diagnostics.status == SystemLinkBroadcastDecodeStatus::kAuthenticationFailed);
+  payload[10] ^= 0x80;
+
+  auto wrong_key = title_lan_key;
+  wrong_key[0] ^= 1;
+  CHECK_FALSE(DecodeSystemLinkBroadcast(payload, DeriveSystemLinkBroadcastKeys(wrong_key),
+                                        &datagram, &diagnostics));
+  CHECK(diagnostics.status == SystemLinkBroadcastDecodeStatus::kAuthenticationFailed);
+}
