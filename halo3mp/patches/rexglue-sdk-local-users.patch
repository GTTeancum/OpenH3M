+struct LocalUserSnapshot {
+  bool initialized = false;
+  uint32_t active_mask = 1;
+  uint32_t active_count = 1;
+  uint32_t next_activation_ms = std::numeric_limits<uint32_t>::max();
+  std::array<uint32_t, 4> signin_state{};
+  std::array<uint32_t, 4> type{};
+  std::array<uint64_t, 4> xuid{};
+  std::array<std::string, 4> name{};
+};
+
+LocalUserSnapshot& MutableLocalUserSnapshot() {
+  static LocalUserSnapshot snapshot;
+  return snapshot;
+}
+
+uint32_t MaxLocalUserCount() {
+  return std::clamp<uint32_t>(REXCVAR_GET(xam_local_user_count), 1, 4);
+}
+
+const std::chrono::steady_clock::time_point& LocalUserStartTime() {
+  static const auto t0 = std::chrono::steady_clock::now();
+  return t0;
+}
+
+uint32_t LocalUserElapsedMs() {
+  return static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                  std::chrono::steady_clock::now() - LocalUserStartTime())
+                                  .count());
+}
+
+const std::vector<uint32_t>& LocalUserActivationMs() {
+  static std::vector<uint32_t> times = [] {
+    std::vector<uint32_t> out;
+    std::string spec = REXCVAR_GET(xam_local_user_activation_ms);
+    size_t pos = 0;
+    while (pos < spec.size()) {
+      size_t comma = spec.find(',', pos);
+      std::string tok =
+          spec.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+      try {
+        out.push_back(static_cast<uint32_t>(std::stoul(tok)));
+      } catch (...) {
+        out.push_back(0);
+      }
+      if (comma == std::string::npos) {
+        break;
+      }
+      pos = comma + 1;
+    }
+    if (!out.empty()) {
+      REXLOG_INFO("[xam-user] local user activation schedule has {} entrie(s)", out.size());
+    }
+    return out;
+  }();
+  return times;
+}
+
+bool IsLocalUserScheduledActive(uint32_t user_index) {
+  const auto& activation_ms = LocalUserActivationMs();
+  if (activation_ms.empty()) {
+    return true;
+  }
+  if (user_index >= activation_ms.size()) {
+    return user_index == 0;
+  }
+  return LocalUserElapsedMs() >= activation_ms[user_index];
+}
+
+uint32_t NextLocalUserActivationMs(uint32_t elapsed_ms, uint32_t max_count) {
+  const auto& activation_ms = LocalUserActivationMs();
+  uint32_t next_ms = std::numeric_limits<uint32_t>::max();
+  for (uint32_t user = 0; user < max_count && user < activation_ms.size(); ++user) {
+    if (activation_ms[user] > elapsed_ms) {
+      next_ms = std::min(next_ms, activation_ms[user]);
+    }
+  }
+  return next_ms;
+}
+
+void RefreshLocalUserSnapshot() {
+  auto& snapshot = MutableLocalUserSnapshot();
+  if (snapshot.initialized &&
+      snapshot.next_activation_ms == std::numeric_limits<uint32_t>::max()) {
+    return;
+  }
+
+  const uint32_t elapsed_ms = LocalUserElapsedMs();
+  if (snapshot.initialized && elapsed_ms < snapshot.next_activation_ms) {
+    return;
+  }
+
+  const uint32_t max_count = MaxLocalUserCount();
+  const auto& activation_ms = LocalUserActivationMs();
+  uint32_t active_mask = 0;
+  uint32_t active_count = 0;
+  for (uint32_t user = 0; user < max_count; ++user) {
+    bool active = false;
+    if (activation_ms.empty()) {
+      active = true;
+    } else if (user < activation_ms.size()) {
+      active = elapsed_ms >= activation_ms[user];
+    } else {
+      active = user == 0;
+    }
+
+    if (active) {
+      active_mask |= 1u << user;
+      ++active_count;
+    }
+  }
+
+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+  const uint32_t profile_signin_state = user_profile->signin_state();
+  const uint64_t profile_xuid = user_profile->xuid();
+  snapshot.signin_state.fill(0);
+  snapshot.type.fill(0);
+  snapshot.xuid.fill(0);
+  for (uint32_t user = 0; user < 4; ++user) {
+    if (!(active_mask & (1u << user))) {
+      continue;
+    }
+    snapshot.signin_state[user] =
+        user == 0 ? profile_signin_state : REXCVAR_GET(xam_guest_signin_state);
+    snapshot.type[user] = user == 0 ? user_profile->type() : 1;
+    snapshot.xuid[user] = profile_xuid + user;
+  }
+  snapshot.name[0] = user_profile->name();
+  for (uint32_t user = 1; user < 4; ++user) {
+    snapshot.name[user] = fmt::format("Guest{}", user + 1);
+  }
+
+  snapshot.active_mask = active_mask ? active_mask : 1;
+  snapshot.active_count = std::max<uint32_t>(active_count, 1);
+  snapshot.next_activation_ms = NextLocalUserActivationMs(elapsed_ms, max_count);
+  snapshot.initialized = true;
+}
+
+const LocalUserSnapshot& LocalUsers() {
+  RefreshLocalUserSnapshot();
+  return MutableLocalUserSnapshot();
+}
+
+uint32_t ActiveLocalUserMask() {
+  return LocalUsers().active_mask;
+}
+
+void MaybeLogXamUserSummary() {
+  const uint32_t interval_ms = REXCVAR_GET(xam_user_summary_interval_ms);
+  if (!interval_ms) {
+    return;
+  }
+
+  const uint32_t elapsed_ms = LocalUserElapsedMs();
+  static std::atomic<uint32_t> next_log_ms{interval_ms};
+  uint32_t target_ms = next_log_ms.load(std::memory_order_relaxed);
+  while (elapsed_ms >= target_ms) {
+    if (next_log_ms.compare_exchange_weak(target_ms, target_ms + interval_ms,
+                                          std::memory_order_relaxed)) {
+      auto& counters = XamUserStatCounters();
+      std::string summary;
+      for (size_t i = 0; i < kXamUserStatCount; ++i) {
+        const uint64_t count = counters[i].exchange(0, std::memory_order_relaxed);
+        if (!count) {
+          continue;
+        }
+        if (!summary.empty()) {
+          summary += ' ';
+        }
+        summary += fmt::format("{}={}", kXamUserStatNames[i], count);
+      }
+      if (!summary.empty()) {
+        const uint32_t mask = ActiveLocalUserMask();
+        uint32_t active_count = 0;
+        for (uint32_t user = 0; user < 4; ++user) {
+          if (mask & (1u << user)) {
+            ++active_count;
+          }
+        }
+        REXLOG_INFO("[xam-user] summary t={}ms mask={:#x} users={} {}", elapsed_ms, mask,
+                    active_count, summary);
+      }
+      return;
+    }
+  }
+}
+
+void RecordXamUserCall(XamUserStat stat) {
+  XamUserStatCounters()[static_cast<size_t>(stat)].fetch_add(1, std::memory_order_relaxed);
+  MaybeLogXamUserSummary();
+}
+
+void PollLocalUserActivation() {
+  static uint32_t last_mask = ActiveLocalUserMask();
+  const uint32_t mask = ActiveLocalUserMask();
+  if (mask == last_mask) {
+    return;
+  }
+  REXLOG_INFO("[xam-user] local user active mask changed {:#x} -> {:#x}", last_mask, mask);
+  last_mask = mask;
+  if (REXCVAR_GET(xam_broadcast_signin_changed)) {
+    REX_KERNEL_STATE()->BroadcastNotification(0x0000000A, mask);
+  }
+}
+
+uint32_t ConfiguredLocalUserCount() {
+  return LocalUsers().active_count;
+}
+
+uint32_t LocalUserCount() { return ConfiguredLocalUserCount(); }
+
+bool IsLocalUser(uint32_t user_index) {
+  return user_index < 4 && (LocalUsers().active_mask & (1u << user_index));
+}
+
+uint64_t LocalUserXuid(uint32_t user_index) {
+  return user_index < 4 ? LocalUsers().xuid[user_index] : 0;
+}
+
+uint32_t LocalUserType(uint32_t user_index) {
+  return user_index < 4 ? LocalUsers().type[user_index] : 0;
+}
+
+uint32_t LocalUserSigninState(uint32_t user_index) {
+  return user_index < 4 ? LocalUsers().signin_state[user_index] : 0;
+}
+
+std::string LocalUserName(uint32_t user_index) {
+  return user_index < 4 ? LocalUsers().name[user_index] : std::string();
+}
+
+bool UserIndexFromXuid(uint64_t xuid, uint32_t* out_user_index) {
+  const auto& users = LocalUsers();
+  for (uint32_t user = 0; user < 4; ++user) {
+    if (!(users.active_mask & (1u << user))) {
+      continue;
+    }
+    if (users.xuid[user] != xuid) {
+      continue;
+    }
+    if (out_user_index) {
+      *out_user_index = user;
+    }
+    return true;
+  }
+  return false;
+}
