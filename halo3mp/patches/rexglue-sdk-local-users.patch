 using namespace rex::system::xam;
 
+namespace {
+
+uint32_t LocalUserCount() { return std::clamp<uint32_t>(REXCVAR_GET(xam_local_user_count), 1, 4); }
+
+bool IsLocalUser(uint32_t user_index) { return user_index < LocalUserCount(); }
+
+uint64_t LocalUserXuid(uint32_t user_index) {
+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+  return user_profile->xuid() + user_index;
+}
+
+uint32_t LocalUserType(uint32_t user_index) {
+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+  return user_index == 0 ? user_profile->type() : 1;
+}
+
+uint32_t LocalUserSigninState(uint32_t user_index) {
+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+  return IsLocalUser(user_index) ? user_profile->signin_state() : 0;
+}
+
+std::string LocalUserName(uint32_t user_index) {
+  if (user_index == 0) {
+    return REX_KERNEL_STATE()->user_profile()->name();
+  }
+  return fmt::format("Guest{}", user_index + 1);
+}
+
+bool UserIndexFromXuid(uint64_t xuid, uint32_t* out_user_index) {
+  for (uint32_t user = 0; user < LocalUserCount(); ++user) {
+    if (LocalUserXuid(user) != xuid) {
+      continue;
+    }
+    if (out_user_index) {
+      *out_user_index = user;
+    }
+    return true;
+  }
+  return false;
+}
+
