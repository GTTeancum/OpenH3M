diff --git a/src/ui/overlay/video_options.h b/src/ui/overlay/video_options.h
new file mode 100644
--- /dev/null
+++ b/src/ui/overlay/video_options.h
@@ -0,0 +1,74 @@
+#pragma once
+#include <rex/cvar.h>
+#include <imgui.h>
+#include <string>
+#include <vector>
+#include <utility>
+namespace rex::ui {
+// Curated video controls use the same cvars and persistence as Advanced settings.
+static void VideoChoice(const char* label, const char* flag,
+                        const std::vector<std::pair<const char*, const char*>>& choices) {
+  auto current = rex::cvar::GetFlagByName(flag);
+  const char* preview = "Custom";
+  for (auto& choice : choices) if (current == choice.second) preview = choice.first;
+  if (ImGui::BeginCombo(label, preview)) {
+    for (auto& choice : choices) {
+      if (ImGui::Selectable(choice.first, current == choice.second))
+        {
+          rex::cvar::SetFlagByName(flag, choice.second);
+          if (std::string(flag) == "resolution_scale") {
+            rex::cvar::SetFlagByName("draw_resolution_scale_x", choice.second);
+            rex::cvar::SetFlagByName("draw_resolution_scale_y", choice.second);
+          }
+        }
+    }
+    ImGui::EndCombo();
+  }
+}
+static void ApplySurfacePreset(int index) {
+  const char* details[] = {"2", "1", "0"};
+  const char* filters[] = {"0", "2", "-1"};
+  rex::cvar::SetFlagByName("texture_detail_reduction", details[index]);
+  rex::cvar::SetFlagByName("anisotropic_override", filters[index]);
+}
+static void DrawVideoOptions() {
+  ImGui::TextUnformatted("Video / Performance");
+  ImGui::TextWrapped("Quality and resolution are independent. Save below to keep changes.");
+  const auto detail = rex::cvar::GetFlagByName("texture_detail_reduction");
+  const auto filter = rex::cvar::GetFlagByName("anisotropic_override");
+  const char* preset = detail == "2" && filter == "0" ? "Performance" :
+                       detail == "1" && filter == "2" ? "Balanced" :
+                       detail == "0" && filter == "-1" ? "Original" : "Custom";
+  if (ImGui::BeginCombo("Surface quality preset [live]", preset)) {
+    const char* names[] = {"Performance", "Balanced", "Original"};
+    for (int i = 0; i < 3; ++i) if (ImGui::Selectable(names[i])) {
+      ApplySurfacePreset(i);
+    }
+    ImGui::EndCombo();
+  }
+  VideoChoice("Surface textures [live]", "texture_detail_reduction",
+              {{"Original", "0"}, {"Medium", "1"}, {"Low", "2"}});
+  VideoChoice("Texture filtering [live]", "anisotropic_override",
+              {{"Game default", "-1"}, {"Off", "0"}, {"2x", "2"}, {"4x", "3"}, {"8x", "4"}, {"16x", "5"}});
+  ImGui::TextWrapped("Lower texture detail softens nearby tiled surfaces while keeping resolution.");
+  VideoChoice("Extra edge smoothing [restart]", "swap_post_effect",
+              {{"Off", "none"}, {"FXAA", "fxaa"}, {"Strong FXAA", "fxaa_extreme"}});
+  ImGui::TextWrapped("Extra smoothing can soften jagged edges, with additional GPU cost.");
+  ImGui::Separator();
+  VideoChoice("Display mode [restart]", "resolution",
+              {{"Game default", ""}, {"720p", "720p"}, {"1080p", "1080p"}, {"1440p", "1440p"}, {"2160p", "4k"}});
+  VideoChoice("Internal render scale [restart]", "resolution_scale",
+              {{"1x", "1"}, {"2x (4x pixels)", "2"}, {"3x (9x pixels)", "3"}});
+  ImGui::TextWrapped("Display mode and internal rendering are separate. Higher render scales cost more GPU time. Restart after saving resolution changes.");
+  ImGui::Separator();
+  if (ImGui::Button("Restore video defaults")) {
+    for (auto& entry : rex::cvar::GetRegistry()) {
+      if (entry.name == "texture_detail_reduction" || entry.name == "anisotropic_override" ||
+          entry.name == "swap_post_effect" || entry.name == "resolution" || entry.name == "resolution_scale" ||
+          entry.name == "draw_resolution_scale_x" || entry.name == "draw_resolution_scale_y")
+        rex::cvar::SetFlagByName(entry.name, entry.default_value);
+    }
+  }
+}
+
+}
