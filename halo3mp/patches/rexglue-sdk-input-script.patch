 // https://msdn.microsoft.com/en-us/library/windows/desktop/microsoft.directx_sdk.reference.xinputgetstate(v=vs.85).aspx
+namespace {
+
+struct ScriptStep {
+  uint32_t at_ms;
+  uint32_t hold_ms;
+  uint16_t buttons;
+  uint16_t virtual_key;
+  int16_t lx;
+  int16_t ly;
+  int16_t rx;
+  int16_t ry;
+  uint8_t lt;
+  uint8_t rt;
+  uint32_t user;
+};
+
+struct ScriptedState {
+  uint16_t buttons;
+  int16_t lx;
+  int16_t ly;
+  int16_t rx;
+  int16_t ry;
+  uint8_t lt;
+  uint8_t rt;
+  bool active;
+};
+
+constexpr int16_t kStick = 30000;
+
+uint32_t ScriptedStateKey(const ScriptedState& st) {
+  return static_cast<uint32_t>(st.buttons) ^ (static_cast<uint32_t>(static_cast<uint16_t>(st.lx)) << 4) ^
+         (static_cast<uint32_t>(static_cast<uint16_t>(st.ly)) << 8) ^
+         (static_cast<uint32_t>(static_cast<uint16_t>(st.rx)) << 12) ^
+         (static_cast<uint32_t>(static_cast<uint16_t>(st.ry)) << 16) ^
+         (static_cast<uint32_t>(st.lt) << 20) ^ (static_cast<uint32_t>(st.rt) << 28);
+}
+
+bool AnalogFromName(const std::string& n, uint16_t& virtual_key, int16_t& lx, int16_t& ly,
+                    int16_t& rx, int16_t& ry, uint8_t& lt, uint8_t& rt) {
+  if (n == "LSUP") { virtual_key = 0x5820; ly = kStick; return true; }
+  if (n == "LSDOWN") { virtual_key = 0x5821; ly = -kStick; return true; }
+  if (n == "LSLEFT") { virtual_key = 0x5823; lx = -kStick; return true; }
+  if (n == "LSRIGHT") { virtual_key = 0x5822; lx = kStick; return true; }
+  if (n == "RSUP") { ry = kStick; return true; }
+  if (n == "RSDOWN") { ry = -kStick; return true; }
+  if (n == "RSLEFT") { rx = -kStick; return true; }
+  if (n == "RSRIGHT") { rx = kStick; return true; }
+  if (n == "LT") { lt = 0xFF; return true; }
+  if (n == "RT") { rt = 0xFF; return true; }
+  return false;
+}
+
+uint16_t ButtonFromName(const std::string& n, uint16_t& virtual_key) {
+  if (n == "A") { virtual_key = 0x5800; return 0x1000; }
+  if (n == "B") { virtual_key = 0x5801; return 0x2000; }
+  if (n == "X") { virtual_key = 0x5802; return 0x4000; }
+  if (n == "Y") { virtual_key = 0x5803; return 0x8000; }
+  if (n == "START") { virtual_key = 0x5814; return 0x0010; }
+  if (n == "BACK") { virtual_key = 0x5815; return 0x0020; }
+  if (n == "UP") { virtual_key = 0x5810; return 0x0001; }
+  if (n == "DOWN") { virtual_key = 0x5811; return 0x0002; }
+  if (n == "LEFT") { virtual_key = 0x5812; return 0x0004; }
+  if (n == "RIGHT") { virtual_key = 0x5813; return 0x0008; }
+  if (n == "LB") { virtual_key = 0x5805; return 0x0100; }
+  if (n == "RB") { virtual_key = 0x5804; return 0x0200; }
+  return 0;
+}
+
+const std::vector<ScriptStep>& ParsedScript() {
+  static std::vector<ScriptStep> steps = [] {
+    std::vector<ScriptStep> out;
+    std::string spec = REXCVAR_GET(input_script);
+    size_t pos = 0;
+    while (pos < spec.size()) {
+      size_t comma = spec.find(',', pos);
+      std::string tok =
+          spec.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+      size_t colon = tok.find(':');
+      if (colon != std::string::npos) {
+        try {
+          uint32_t at = static_cast<uint32_t>(std::stoul(tok.substr(0, colon)));
+          std::string name = tok.substr(colon + 1);
+          uint32_t user = 0;
+          uint32_t hold_ms = 0;
+          size_t at_sign = name.find('@');
+          if (at_sign != std::string::npos) {
+            std::string user_spec = name.substr(at_sign + 1);
+            size_t user_end = user_spec.find('+');
+            if (user_end != std::string::npos) {
+              hold_ms = static_cast<uint32_t>(std::stoul(user_spec.substr(user_end + 1)));
+              user_spec = user_spec.substr(0, user_end);
+            }
+            user = static_cast<uint32_t>(std::stoul(user_spec));
+            name = name.substr(0, at_sign);
+          }
+          int16_t lx = 0, ly = 0, rx = 0, ry = 0;
+          uint8_t lt = 0, rt = 0;
+          uint16_t virtual_key = 0;
+          size_t plus = name.find('+');
+          if (plus != std::string::npos) {
+            hold_ms = static_cast<uint32_t>(std::stoul(name.substr(plus + 1)));
+            name = name.substr(0, plus);
+          }
+          uint16_t b = ButtonFromName(name, virtual_key);
+          if (b || AnalogFromName(name, virtual_key, lx, ly, rx, ry, lt, rt)) {
+            out.push_back({at, hold_ms, b, virtual_key, lx, ly, rx, ry, lt, rt, user});
+          }
+        } catch (...) {
+        }
+      }
+      if (comma == std::string::npos) break;
+      pos = comma + 1;
+    }
+    if (!out.empty()) {
+      REXKRNL_INFO("[input-script] {} step(s) armed", out.size());
+    }
+    return out;
+  }();
+  return steps;
+}
+
+bool HasScriptFor(uint32_t user) {
+  for (const auto& step : ParsedScript()) {
+    if (step.user == user) {
+      return true;
+    }
+  }
+  return false;
+}
+
+ScriptedState ScriptedFor(uint32_t user) {
+  ScriptedState st{0, 0, 0, 0, 0, 0, 0, false};
+  const auto& steps = ParsedScript();
+  if (steps.empty()) return st;
+  static const auto t0 = std::chrono::steady_clock::now();
+  const uint32_t ms = static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                std::chrono::steady_clock::now() - t0)
+                                                .count());
+  const uint32_t default_hold = static_cast<uint32_t>(REXCVAR_GET(input_script_hold));
+  for (const auto& s2 : steps) {
+    if (s2.user != user) continue;
+    const uint32_t hold = s2.hold_ms ? s2.hold_ms : default_hold;
+    if (ms >= s2.at_ms && ms < s2.at_ms + hold) {
+      st.buttons |= s2.buttons;
+      if (s2.lx) st.lx = s2.lx;
+      if (s2.ly) st.ly = s2.ly;
+      if (s2.rx) st.rx = s2.rx;
+      if (s2.ry) st.ry = s2.ry;
+      if (s2.lt) st.lt = s2.lt;
+      if (s2.rt) st.rt = s2.rt;
+      st.active = true;
+    }
+  }
+  static uint32_t last_key[4] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
+  const uint32_t slot = user < 4 ? user : 0;
+  const uint32_t key = (user << 24) ^ ScriptedStateKey(st);
+  if (key != last_key[slot]) {
+    REXKRNL_INFO("[input-script] t={}ms user={} buttons={:#06x} lx={} ly={} rx={} ry={} lt={} rt={}",
+                 ms, user, st.buttons, st.lx, st.ly, st.rx, st.ry, st.lt, st.rt);
+    last_key[slot] = key;
+  }
+  return st;
+}
+
+bool ScriptedKeystrokeFor(uint32_t user, ppc_ptr_t<X_INPUT_KEYSTROKE> keystroke) {
+  const auto& steps = ParsedScript();
+  if (steps.empty()) return false;
+  static const auto t0 = std::chrono::steady_clock::now();
+  const uint32_t ms = static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                std::chrono::steady_clock::now() - t0)
+                                                .count());
+  static std::vector<bool> emitted;
+  if (emitted.size() != steps.size()) {
+    emitted.assign(steps.size(), false);
+  }
+  for (size_t i = 0; i < steps.size(); ++i) {
+    const auto& s2 = steps[i];
+    if (emitted[i] || s2.user != user || !s2.virtual_key || ms < s2.at_ms) {
+      continue;
+    }
+    emitted[i] = true;
+    keystroke->virtual_key = s2.virtual_key;
+    keystroke->unicode = 0;
+    keystroke->flags = rex::input::X_INPUT_KEYSTROKE_KEYDOWN;
+    keystroke->user_index = static_cast<uint8_t>(user);
+    keystroke->hid_code = 0;
+    REXKRNL_INFO("[input-script] keystroke t={}ms user={} vk={:#06x}", ms, user,
+                 s2.virtual_key);
+    return true;
+  }
+  return false;
+}
+
+bool ScriptedKeystrokeAny(ppc_ptr_t<X_INPUT_KEYSTROKE> keystroke, uint32_t* out_user = nullptr) {
+  for (uint32_t user = 0; user < 4; ++user) {
+    if (!ScriptedKeystrokeFor(user, keystroke)) {
+      continue;
+    }
+    if (out_user) {
+      *out_user = user;
+    }
+    return true;
+  }
+  return false;
+}
+
+struct NamedButton {
+  const char* name;
+  uint16_t bit;
+};
+
+constexpr NamedButton kLoggedButtons[] = {
+    {"UP", 0x0001},    {"DOWN", 0x0002}, {"LEFT", 0x0004}, {"RIGHT", 0x0008},
+    {"START", 0x0010}, {"BACK", 0x0020}, {"LB", 0x0100},   {"RB", 0x0200},
+    {"A", 0x1000},     {"B", 0x2000},    {"X", 0x4000},    {"Y", 0x8000},
+};
+
+#if defined(_WIN32)
+bool KeyDown(int virtual_key) {
+  return (GetAsyncKeyState(virtual_key) & 0x8000) != 0;
+}
+#endif
+
+void AddKeyboardButton(ScriptedState& st, bool pressed, uint16_t button) {
+  if (pressed) {
+    st.buttons |= button;
+    st.active = true;
+  }
+}
+
+void AddKeyboardStick(ScriptedState& st, bool negative, bool positive, int16_t& axis) {
+  if (negative == positive) {
+    return;
+  }
+  axis = negative ? -kStick : kStick;
+  st.active = true;
+}
+
+ScriptedState KeyboardControllerFor(uint32_t user) {
+  ScriptedState st{0, 0, 0, 0, 0, 0, 0, false};
+  if (!REXCVAR_GET(keyboard_controller) || user != 0) {
+    return st;
+  }
+#if defined(_WIN32)
+  AddKeyboardButton(st, KeyDown(VK_UP), 0x0001);
+  AddKeyboardButton(st, KeyDown(VK_DOWN), 0x0002);
+  AddKeyboardButton(st, KeyDown(VK_LEFT), 0x0004);
+  AddKeyboardButton(st, KeyDown(VK_RIGHT), 0x0008);
+  AddKeyboardButton(st, KeyDown(VK_RETURN) || KeyDown(VK_SPACE), 0x1000);
+  AddKeyboardButton(st, KeyDown(VK_ESCAPE) || KeyDown(VK_BACK), 0x2000);
+  AddKeyboardButton(st, KeyDown('X'), 0x4000);
+  AddKeyboardButton(st, KeyDown('Y'), 0x8000);
+  AddKeyboardButton(st, KeyDown('P'), 0x0010);
+  AddKeyboardButton(st, KeyDown('O'), 0x0020);
+  AddKeyboardButton(st, KeyDown('Q'), 0x0100);
+  AddKeyboardButton(st, KeyDown('E'), 0x0200);
+  AddKeyboardStick(st, KeyDown('A'), KeyDown('D'), st.lx);
+  AddKeyboardStick(st, KeyDown('S'), KeyDown('W'), st.ly);
+#endif
+  return st;
+}
+
+void LogKeyboardTransitions(const ScriptedState& keyboard) {
+  if (!REXCVAR_GET(keyboard_controller_log)) {
+    return;
+  }
+  static uint16_t last_buttons = 0;
+  static int16_t last_lx = 0;
+  static int16_t last_ly = 0;
+  static const auto t0 = std::chrono::steady_clock::now();
+  const uint32_t ms = static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                std::chrono::steady_clock::now() - t0)
+                                                .count());
+  const uint16_t changed = static_cast<uint16_t>(last_buttons ^ keyboard.buttons);
+  for (const auto& button : kLoggedButtons) {
+    if (!(changed & button.bit)) {
+      continue;
+    }
+    REXKRNL_INFO("[keyboard-controller] t={}ms {} {}", ms,
+                 (keyboard.buttons & button.bit) ? "down" : "up", button.name);
+  }
+  if (keyboard.lx != last_lx) {
+    REXKRNL_INFO("[keyboard-controller] t={}ms LX {}", ms, keyboard.lx);
+  }
+  if (keyboard.ly != last_ly) {
+    REXKRNL_INFO("[keyboard-controller] t={}ms LY {}", ms, keyboard.ly);
+  }
+  last_buttons = keyboard.buttons;
+  last_lx = keyboard.lx;
+  last_ly = keyboard.ly;
+}
+
+bool HasSyntheticInput(uint32_t user) {
+  return HasScriptFor(user) || (REXCVAR_GET(keyboard_controller) && user == 0);
+}
+
+ScriptedState MergedSyntheticFor(uint32_t user) {
+  ScriptedState merged{0, 0, 0, 0, 0, 0, 0, false};
+  if (HasScriptFor(user)) {
+    const ScriptedState script = ScriptedFor(user);
+    merged.buttons |= script.buttons;
+    if (script.lx) merged.lx = script.lx;
+    if (script.ly) merged.ly = script.ly;
+    if (script.rx) merged.rx = script.rx;
+    if (script.ry) merged.ry = script.ry;
+    if (script.lt) merged.lt = script.lt;
+    if (script.rt) merged.rt = script.rt;
+    merged.active |= script.active;
+  }
+  const ScriptedState keyboard = KeyboardControllerFor(user);
+  LogKeyboardTransitions(keyboard);
+  merged.buttons |= keyboard.buttons;
+  if (keyboard.lx) merged.lx = keyboard.lx;
+  if (keyboard.ly) merged.ly = keyboard.ly;
+  if (keyboard.rx) merged.rx = keyboard.rx;
+  if (keyboard.ry) merged.ry = keyboard.ry;
+  if (keyboard.lt) merged.lt = keyboard.lt;
+  if (keyboard.rt) merged.rt = keyboard.rt;
+  merged.active |= keyboard.active;
+  return merged;
+}
+
+bool FillSyntheticCapabilities(uint32_t user, ppc_ptr_t<X_INPUT_CAPABILITIES> caps) {
+  if (!HasSyntheticInput(user) || user >= 4 || !caps) {
+    return false;
+  }
+  std::memset(caps, 0, sizeof(X_INPUT_CAPABILITIES));
+  caps->type = rex::input::XINPUT_DEVTYPE_GAMEPAD;
+  caps->sub_type = 0x01;
+  caps->gamepad.buttons = 0xF3FF;
+  caps->gamepad.left_trigger = 0xFF;
+  caps->gamepad.right_trigger = 0xFF;
+  caps->gamepad.thumb_lx = INT16_MAX;
+  caps->gamepad.thumb_ly = INT16_MAX;
+  caps->gamepad.thumb_rx = INT16_MAX;
+  caps->gamepad.thumb_ry = INT16_MAX;
+  return true;
+}
