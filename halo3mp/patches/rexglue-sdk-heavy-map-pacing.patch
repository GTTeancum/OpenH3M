--- /dev/null
+++ b/include/rex/ui/host_output_schedule.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <cmath>
+namespace rex::ui {
+// Host-only deadlines. Units may be QPC ticks or seconds; guest time is untouched.
+struct HostOutputSchedule {
+  const void* owner = nullptr;
+  int rate = 0;
+  double next = 0, period = 0;
+  double Advance(const void* new_owner, int new_rate, double now,
+                 double anchor, double new_period) {
+    if (owner != new_owner || rate != new_rate ||
+        std::abs(period / new_period - 1.0) > 0.01) {
+      *this = {new_owner, new_rate,
+          anchor + (std::floor((now - anchor) / new_period) + 1.0) * new_period,
+          new_period};
+    }
+    // Retain the assigned slot while following updated DXGI phase samples.
+    // Accumulating estimated periods without rebasing slowly loses phase.
+    next = anchor + std::round((next - anchor) / new_period) * new_period;
+    if (now - next > new_period) next = now;
+    const double target = next;
+    next += new_period;
+    period = new_period;
+    return target;
+  }
+};
+}
