+
+bool InputSystem::IsActive() const {
+  return focused_.load(std::memory_order_acquire) &&
+         (!active_callback_ || active_callback_());
+}
+
+void InputSystem::SetWindowFocused(bool focused) {
+  if (focused_.load(std::memory_order_acquire) == focused) return;
+  // Close the gate before clearing queues, and reopen only after clearing.
+  focused_.store(false, std::memory_order_release);
+  for (auto& driver : drivers_) driver->OnInputFocusChanged(focused);
+  focus_generation_.fetch_add(1, std::memory_order_acq_rel);
+  focused_.store(focused, std::memory_order_release);
+}
+
+void InputSystem::OnLostFocus(ui::UISetupEvent&) { SetWindowFocused(false); }
+void InputSystem::OnGotFocus(ui::UISetupEvent&) { SetWindowFocused(true); }
+void InputSystem::OnClosing(ui::UIEvent&) {
+  SetWindowFocused(false);
+  DetachWindow();
+}
+
+void InputSystem::DetachWindow() {
+  if (!window_) return;
+  auto* window = window_;
+  window->app_context().CallInUIThreadSynchronous([this, window] {
+    window->RemoveListener(this);
+    window_ = nullptr;
+  });
 }
 
