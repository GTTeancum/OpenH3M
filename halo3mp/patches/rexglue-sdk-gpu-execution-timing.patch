+int D3D12CommandProcessor::PrepareGpuTiming() {
+  if (!REXCVAR_GET(d3d12_log_present_timing)) return -1;
+  if (!gpu_timing_attempted_) {
+    gpu_timing_attempted_ = true;
+    auto* device = GetD3D12Provider().GetDevice();
+    D3D12_QUERY_HEAP_DESC desc = {};
+    desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    desc.Count = 512;
+    D3D12_RESOURCE_DESC buffer;
+    ui::d3d12::util::FillBufferResourceDesc(buffer, 512 * sizeof(uint64_t), D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateQueryHeap(&desc, IID_PPV_ARGS(&gpu_timing_heap_))) ||
+        FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+            D3D12_HEAP_FLAG_NONE, &buffer, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&gpu_timing_readback_))) ||
+        FAILED(GetD3D12Provider().GetDirectQueue()->GetTimestampFrequency(&gpu_timing_frequency_))) {
+      REXGPU_WARN("GPU timing diagnostic initialization failed");
+      return -1;
+    }
+    D3D12_RANGE range = {0, 512 * sizeof(uint64_t)};
+    void* mapping = nullptr;
+    if (FAILED(gpu_timing_readback_->Map(0, &range, &mapping))) return -1;
+    gpu_timing_mapping_ = static_cast<uint64_t*>(mapping);
+  }
+  if (!gpu_timing_mapping_ || !gpu_timing_frequency_) return -1;
+  const uint64_t completed = submission_fence_->GetCompletedValue();
+  if (completed == UINT64_MAX) return -1;
+  for (uint32_t i = 0; i < gpu_timing_slots_.size(); ++i) {
+    auto& slot = gpu_timing_slots_[i];
+    if (!slot.submission || slot.submission > completed) continue;
+    const auto begin = gpu_timing_mapping_[i * 2], end = gpu_timing_mapping_[i * 2 + 1];
+    if (end >= begin) REXGPU_INFO("[gpu-execution] submission={} frame={} closes_frame={} elapsed_ms={:.3f}",
+        slot.submission, slot.frame, slot.closes_frame,
+        double(end - begin) * 1000.0 / double(gpu_timing_frequency_));
+    slot = {};
+  }
+  const uint32_t index = uint32_t(submission_current_ % gpu_timing_slots_.size());
+  return gpu_timing_slots_[index].submission ? -1 : int(index);
+}
