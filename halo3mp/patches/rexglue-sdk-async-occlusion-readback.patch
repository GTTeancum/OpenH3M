+bool D3D12CommandProcessor::StartOcclusionWorker() {
+  if (occlusion_worker_.joinable()) return true;
+  occlusion_worker_event_ = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+  if (!occlusion_worker_event_) return false;
+  occlusion_worker_stop_.store(false);
+  occlusion_worker_ = std::thread([this]() {
+    uint32_t published = 0;
+    bool saw_hidden = false, saw_visible = false;
+    while (true) {
+      PendingOcclusion pending;
+      {
+        std::unique_lock<std::mutex> lock(occlusion_pending_mutex_);
+        occlusion_pending_cv_.wait(lock, [this]() {
+          return occlusion_worker_stop_.load() || !occlusion_pending_.empty();
+        });
+        if (occlusion_pending_.empty()) break;
+        pending = std::move(occlusion_pending_.front());
+        occlusion_pending_.pop_front();
+      }
+      uint64_t completed = submission_fence_->GetCompletedValue();
+      if (completed < pending.submission &&
+          SUCCEEDED(submission_fence_->SetEventOnCompletion(pending.submission, occlusion_worker_event_))) {
+        while (!occlusion_worker_stop_.load() &&
+               WaitForSingleObject(occlusion_worker_event_, 100) == WAIT_TIMEOUT) {}
+        completed = submission_fence_->GetCompletedValue();
+      }
+      if (completed != UINT64_MAX && completed >= pending.submission) {
+        uint64_t samples = 0;
+        for (uint32_t index : pending.indices) samples += occlusion_query_readback_mapping_[index];
+        samples = (samples + (pending.scale >> 1)) / pending.scale;
+        WriteGuestOcclusionResult(pending.destination, samples);
+        bool& seen = samples ? saw_visible : saw_hidden;
+        if (++published <= 4 || !seen) REXGPU_INFO("Async occlusion result published: samples={} segments={}",
+                                                  samples, pending.indices.size());
+        seen = true;
+      } else {
+        REXGPU_WARN("Visibility result unavailable at fence {}", pending.submission);
+      }
+      for (uint32_t index : pending.indices) occlusion_reserved_[index].store(false);
+    }
+  });
+  return true;
+}
+
+void D3D12CommandProcessor::StopOcclusionWorker() {
+  occlusion_worker_stop_.store(true);
+  occlusion_pending_cv_.notify_one();
+  if (occlusion_worker_.joinable()) occlusion_worker_.join();
+  if (occlusion_worker_event_) CloseHandle(occlusion_worker_event_);
+  occlusion_worker_event_ = nullptr;
+  for (auto& reserved : occlusion_reserved_) reserved.store(false);
+}
