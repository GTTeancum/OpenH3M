diff --git a/include/rex/ui/video_metrics.h b/include/rex/ui/video_metrics.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/video_metrics.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <array>
+#include <cstdint>
+namespace rex::ui {
+struct VideoMetrics { double cpu_ms = -1, gpu_ms = -1; };
+void PublishVideoCpuFrame(double milliseconds);
+void PublishVideoGpuFrame(double milliseconds);
+VideoMetrics ReadVideoMetrics();
+// Feed completed timestamp pairs in submission order. Never includes fence or
+// presentation waits. Missing submissions invalidate that frame's measurement.
+struct VideoGpuAccumulator {
+  uint64_t frame = 0, submission = 0;
+  double total = 0;
+  bool started = false, valid = false;
+  double Add(uint64_t next_frame, uint64_t next_submission, double ms) {
+    double completed = -1;
+    const bool contiguous = submission && next_submission == submission + 1;
+    if (!started || next_frame != frame) {
+      if (started && valid && contiguous) completed = total;
+      valid = contiguous;
+      total = 0;
+      frame = next_frame;
+      started = true;
+    } else if (!contiguous) valid = false;
+    if (ms < 0) valid = false; else total += ms;
+    submission = next_submission;
+    return completed;
+  }
+};
+}
diff --git a/src/ui/video_metrics.cpp b/src/ui/video_metrics.cpp
new file mode 100644
--- /dev/null
+++ b/src/ui/video_metrics.cpp
@@ -0,0 +1,30 @@
+#include <rex/ui/video_metrics.h>
+#include <chrono>
+#include <cmath>
+#include <mutex>
+namespace rex::ui {
+namespace {
+using Clock = std::chrono::steady_clock;
+struct Samples {
+  std::array<double, 30> values{};
+  size_t count = 0, index = 0;
+  Clock::time_point updated{};
+  void Add(double ms) {
+    if (!std::isfinite(ms) || ms < 0) return;
+    values[index] = ms; index = (index + 1) % values.size();
+    if (count < values.size()) ++count;
+    updated = Clock::now();
+  }
+  double Mean() const {
+    if (!count || Clock::now() - updated > std::chrono::seconds(2)) return -1;
+    double total = 0; for (size_t i = 0; i < count; ++i) total += values[i];
+    return total / count;
+  }
+};
+std::mutex mutex;
+Samples cpu, gpu;
+}
+void PublishVideoCpuFrame(double ms) { std::lock_guard lock(mutex); cpu.Add(ms); }
+void PublishVideoGpuFrame(double ms) { std::lock_guard lock(mutex); gpu.Add(ms); }
+VideoMetrics ReadVideoMetrics() { std::lock_guard lock(mutex); return {cpu.Mean(), gpu.Mean()}; }
+}
