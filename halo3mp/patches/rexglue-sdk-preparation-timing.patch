 namespace rex::graphics::d3d12 {
+namespace {
+class PreparationTimer {
+ public:
+  PreparationTimer(const char* kind, uint64_t shader)
+      : kind_(kind), shader_(shader), threshold_(REXCVAR_GET(d3d12_slow_preparation_ms)) {
+    if (threshold_) start_ = std::chrono::steady_clock::now();
+  }
+  ~PreparationTimer() {
+    if (!threshold_) return;
+    const double ms = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - start_).count();
+    if (ms >= threshold_) {
+      REXGPU_INFO("[preparation] kind={} shader={:016X} elapsed_ms={:.3f}", kind_, shader_, ms);
+    }
+  }
+ private:
+  const char* kind_;
+  uint64_t shader_;
+  uint32_t threshold_;
+  std::chrono::steady_clock::time_point start_{};
+};
+}  // namespace
