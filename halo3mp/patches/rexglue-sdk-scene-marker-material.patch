diff --git a/include/rex/graphics/d3d12/scene_marker_shader.h b/include/rex/graphics/d3d12/scene_marker_shader.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/d3d12/scene_marker_shader.h
@@ -0,0 +1,45 @@
+#pragma once
+// Shared kernel for offline material compilation. Keep its constants in sync
+// with D3D12SceneMarkers::Draw and bump the private pack version on ABI changes.
+namespace rex::graphics::d3d12 {
+inline constexpr const char* kSceneMarkerKernel = R"(
+    RWTexture2D<float4> target : register(u0);
+    #ifdef MULTISAMPLED
+    Texture2DMS<float> scene : register(t0);
+    #else
+    Texture2D<float> scene : register(t0);
+    #endif
+    cbuffer Marker : register(b0) {
+      float2 center; float radius; float marker_depth;
+      uint2 origin; uint2 output_size;
+      float2 depth_scale; float2 depth_offset;
+      float4 color;
+      uint samples; float epsilon; float elapsed; float view_depth;
+    };
+    [numthreads(8,8,1)] void main(uint3 tid:SV_DispatchThreadID) {
+      uint2 p=origin+tid.xy;
+      if(any(p>=output_size)) return;
+      float2 uv=(float2(p)+.5-center)/(2*radius)+.5;
+      if(any(uv<0)||any(uv>1))return;
+      int2 dp=int2((float2(p)+.5)*depth_scale+depth_offset);
+      uint depth_width,depth_height;
+      #ifdef MULTISAMPLED
+      uint depth_samples;
+      scene.GetDimensions(depth_width,depth_height,depth_samples);
+      #else
+      scene.GetDimensions(depth_width,depth_height);
+      #endif
+      if(any(dp<0) || dp.x>=depth_width || dp.y>=depth_height) return;
+      float visible=0;
+      #ifdef MULTISAMPLED
+      for(uint i=0;i<samples;++i) visible += marker_depth+epsilon>=scene.Load(dp,i);
+      visible/=samples;
+      #else
+      visible=marker_depth+epsilon>=scene.Load(int3(dp,0));
+      #endif
+      if(visible<=0)return;
+      float3 light=MarkerMaterial(uv,elapsed,view_depth)*visible;
+      float4 old=target[p];
+      target[p]=float4(old.rgb+light,old.a);
+    })";
+}
