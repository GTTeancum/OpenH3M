+bool D3D12SceneMarkers::Initialize(bool msaa) {
+  if(!captured_.material || (material_ && material_!=captured_.material))return false;
+  if(pipeline_[msaa?1:0])return true;
+  if(preparation_failed_)return false;
+  const auto started=std::chrono::steady_clock::now();
+  try {
+    if(!preparation_.valid()) {
+      material_=captured_.material;
+      ComPtr<ID3D12Device> device=cp_.GetD3D12Provider().GetDevice();
+      preparation_=std::async(std::launch::async,&D3D12SceneMarkers::PrepareMaterial,std::move(device),material_);
+      const auto elapsed=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-started).count();
+      REXGPU_INFO("Scene marker preparation dispatched: render_ms={:.3f}",elapsed);
+      return false;
+    }
+    if(preparation_.wait_for(std::chrono::seconds(0))!=std::future_status::ready)return false;
+    auto prepared=preparation_.get();
+    if(FAILED(prepared.result)) {
+      preparation_failed_=true;
+      REXGPU_ERROR("Background scene marker preparation failed: {:08X}",uint32_t(prepared.result));
+      return false;
+    }
+    root_=std::move(prepared.root);material_pixels_=std::move(prepared.pixels);
+    for(unsigned i=0;i<2;++i)pipeline_[i]=std::move(prepared.pipelines[i]);
+    const auto elapsed=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-started).count();
+    REXGPU_INFO("Scene marker preparation adopted: worker_ms={:.3f} render_ms={:.3f}",prepared.milliseconds,elapsed);
+    return true;
+  }catch(const std::exception& error) {
+    preparation_failed_=true;
+    REXGPU_ERROR("Scene marker preparation failed: {}",error.what());
+    return false;
+  }
 }
 
