+// Original Halo 3 Mythic virtual-call adapter, missed by older generated maps.
+// Mirrors all nine PPC instructions; preserves LR/CR and tail-calls the target.
+static void Halo3VirtualAdapter8263D8F8(PPCContext& ctx, uint8_t* base) {
+  auto* memory = Runtime::instance()->memory();
+  auto load = [memory](uint64_t address) {
+    return memory::load_and_swap<uint32_t>(memory->TranslateVirtual(static_cast<uint32_t>(address)));
+  };
+  ctx.r3.u64 = load(ctx.r3.u64 + 4);
+  ctx.r4.u64 = ctx.r5.u64;
+  ctx.r5.u64 = ctx.r6.u64;
+  ctx.r6.u64 = ctx.r7.u64;
+  ctx.r7.u64 = ctx.r9.u64;
+  ctx.r11.u64 = load(ctx.r3.u64);
+  ctx.r11.u64 = load(ctx.r11.u64 + 0x1c);
+  ctx.ctr.u64 = ctx.r11.u64;
+  ctx.last_indirect_target = static_cast<uint32_t>(ctx.ctr.u64) & ~3u;
+  ResolveIndirectFunction(ctx.last_indirect_target)(ctx, base);
+}
