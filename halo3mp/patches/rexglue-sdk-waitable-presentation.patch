 namespace rex::ui::d3d12 {
+namespace {
+std::mutex latency_handles_mutex;
+std::map<IDXGISwapChain3*, HANDLE> latency_handles;
+HANDLE FindLatencyHandle(IDXGISwapChain3* chain) {
+  std::lock_guard<std::mutex> lock(latency_handles_mutex);
+  auto it = latency_handles.find(chain);
+  return it != latency_handles.end() ? it->second : nullptr;
+}
+void CloseLatencyHandle(IDXGISwapChain3* chain) {
+  std::lock_guard<std::mutex> lock(latency_handles_mutex);
+  auto it = latency_handles.find(chain);
+  if (it != latency_handles.end()) {
+    CloseHandle(it->second);
+    latency_handles.erase(it);
+  }
+}
+}  // namespace
