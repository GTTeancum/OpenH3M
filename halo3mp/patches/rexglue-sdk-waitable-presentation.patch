 Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  if (HANDLE latency = FindLatencyHandle(paint_context_.swap_chain.Get())) {
+    // Keep the UI responsive on occlusion/device loss. No queue work is held.
+    const DWORD wait_result = WaitForSingleObjectEx(latency, 100, FALSE);
+    if (wait_result != WAIT_OBJECT_0) {
+      REXLOG_WARN("Host presentation capacity wait returned {}", wait_result);
+      return PaintResult::kNotPresented;
+    }
+  }
+
   // Begin the command list with the command allocator not currently potentially
   // used on the GPU.
   UINT64 current_paint_submission = paint_context_.paint_submission_tracker.GetCurrentSubmission();
